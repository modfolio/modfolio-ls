{
	"name": "modfolio-ls",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"packageManager": "bun@1.2.4",
	"scripts": {
		"build": "bun run --cwd apps/landing build",
		"build:app": "bun run --cwd apps/app build",
		"dev": "bun run --cwd apps/landing dev",
		"dev:app": "bun run --cwd apps/app dev",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "bun run --cwd apps/landing typecheck",
		"typecheck:app": "bun run --cwd apps/app typecheck",
		"quality:all": "bun run check && bun run typecheck && bun run typecheck:app"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"typescript": "^5.9.3"
	}
}
