---
import AppShowcase from "../components/landing/AppShowcase.astro";
import CallToAction from "../components/landing/CallToAction.astro";
import Footer from "../components/landing/Footer.astro";
import Hero from "../components/landing/Hero.astro";
import ValueProp from "../components/landing/ValueProp.astro";
import AppGrid from "../components/portal/AppGrid.astro";
import ContentFeed from "../components/portal/ContentFeed.astro";
import PortalHeader from "../components/portal/PortalHeader.astro";
import GlowOrb from "../components/shared/GlowOrb.astro";
import Nav from "../components/shared/Nav.astro";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;
const title = user ? "포털 — Modfolio LS" : "Modfolio LS — Lifestyle Group";
---

<Base title={title}>
	<GlowOrb variant="plum" />
	<GlowOrb variant="sky" />
	<Nav user={user} />

	{user ? (
		<main id="main" class="portal container">
			<PortalHeader user={user} />
			<AppGrid />
			<ContentFeed />
		</main>
	) : (
		<main id="main">
			<Hero />
			<AppShowcase />
			<ValueProp />
			<CallToAction />
			<Footer />
		</main>
	)}
</Base>

<style>
	.portal {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-8) var(--ls-space-12);
	}
</style>
