---
import AppShowcase from "../components/landing/AppShowcase.astro";
import CallToAction from "../components/landing/CallToAction.astro";
import Footer from "../components/landing/Footer.astro";
import Hero from "../components/landing/Hero.astro";
import ValueProp from "../components/landing/ValueProp.astro";
import Nav from "../components/shared/Nav.astro";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;
if (user) return Astro.redirect("https://life.modfolio.io");
---

<Base>
	<Nav user={user} />

	<main id="main">
		<Hero />
		<AppShowcase />
		<ValueProp />
		<CallToAction />
		<Footer />
	</main>
</Base>
