---
import AppShowcase from "../components/landing/AppShowcase.astro";
import CallToAction from "../components/landing/CallToAction.astro";
import Footer from "../components/landing/Footer.astro";
import Hero from "../components/landing/Hero.astro";
import Manifesto from "../components/landing/Manifesto.astro";
import Nav from "../components/shared/Nav.astro";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;

if (user) {
	return Astro.redirect("https://life.modfolio.io");
}
---

<Base
	title="Modfolio LS — 삶을 누리는 방법."
	description="당신이 누릴 수 있는 일상은 아직 더 있습니다. Modfolio의 라이프스타일 그룹."
>
	<Nav user={user} current="/" />
	<main id="main">
		<Hero />
		<Manifesto />
		<AppShowcase />
		<CallToAction />
	</main>
	<Footer />
</Base>
