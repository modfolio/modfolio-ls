---
import AppShowcase from "../components/landing/AppShowcase.astro";
import CallToAction from "../components/landing/CallToAction.astro";
import Footer from "../components/landing/Footer.astro";
import Hero from "../components/landing/Hero.astro";
import Horizon from "../components/landing/Horizon.astro";
import Manifesto from "../components/landing/Manifesto.astro";
import Nav from "../components/shared/Nav.astro";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;

if (user) {
	return Astro.redirect("https://life.modfolio.io");
}
---

<Base
	title="Modfolio LS — 여행을 그리고, 매일을 기록하다"
	description="같은 여행도 직접 그리면 달라집니다. Modfolio의 라이프스타일 서비스."
>
	<Nav user={user} current="/" />
	<main id="main">
		<Hero />
		<Manifesto />
		<AppShowcase />
		<Horizon />
		<CallToAction />
	</main>
	<Footer />
</Base>
