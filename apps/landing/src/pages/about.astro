---
import Footer from "../components/landing/Footer.astro";
import Nav from "../components/shared/Nav.astro";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;
---

<Base title="About - Modfolio LS" description="Modfolio LS 그룹의 이야기.">
	<Nav user={user} current="/about" />

	<main id="main">
		<section class="hero" aria-labelledby="about-heading">
			<div class="container hero-inner">
				<h1 id="about-heading" class="hero-title reveal">
					<span class="gradient-text" lang="en">Modfolio LS</span>의 이야기
				</h1>
				<p class="hero-lead reveal" style="--reveal-delay: 0.15s">
					여행 설계부터 자기관리까지,<br />흩어진 일상을 하나로 연결합니다.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="mission-card reveal" style="--reveal-delay: 0.2s">
					<p class="mission-label">미션</p>
					<p class="mission-text">
						라이프스타일이 도구의 나열이 아니라<br />
						하나의 경험이어야 한다고 믿습니다.
					</p>
					<p class="mission-sub">
						여행을 설계하고, 습관을 기록하고, 성실함을 증명하는 모든 순간이
						자연스럽게 이어지는 일상을 만들어갑니다.
					</p>
				</div>
			</div>
		</section>

		<section class="section section-raised" aria-labelledby="apps-heading">
			<div class="container">
				<h2 id="apps-heading" class="center-title reveal">두 가지 도구, 하나의 철학</h2>
				<div class="app-grid">
					<div class="app-card reveal" data-app="keepnbuild" style="--reveal-delay: 0.15s">
						<h3 class="app-name" lang="en">KeepNBuild</h3>
						<p class="app-tagline">Custom Travel Design</p>
						<p class="app-desc">어디로 떠날지, 무엇을 경험할지. 당신만의 여행을 직접 설계하고 기록하세요.</p>
						<a href="https://keepnbuild.com" class="app-link" target="_blank" rel="noopener" lang="en">keepnbuild.com &rarr;</a>
					</div>
					<div class="app-card reveal" data-app="worthee" style="--reveal-delay: 0.3s">
						<h3 class="app-name" lang="en">Worthee</h3>
						<p class="app-tagline">Honor &amp; Self-Management</p>
						<p class="app-desc">습관을 기록하고 인증하면 커뮤니티가 검증합니다. 성실함이 명예가 되는 곳.</p>
						<a href="https://worthee.io" class="app-link" target="_blank" rel="noopener" lang="en">worthee.io &rarr;</a>
					</div>
				</div>
			</div>
		</section>

		<section class="section section-gradient">
			<div class="container">
				<div class="eco-card reveal" style="--reveal-delay: 0.2s">
					<h2 class="eco-title"><span lang="en">Modfolio</span> 생태계</h2>
					<p class="eco-body">
						<span lang="en">Modfolio LS</span>는
						<span lang="en">Modfolio</span> 생태계의 라이프스타일 그룹입니다.
						하나의 계정으로 모든 서비스를 이용하세요.
					</p>
					<div class="eco-links">
						<a href="https://modfolio.io" target="_blank" rel="noopener" class="eco-pill" lang="en">Modfolio</a>
						<a href="https://connect.modfolio.io" target="_blank" rel="noopener" class="eco-pill" lang="en">Connect</a>
						<a href="https://pay.modfolio.io" target="_blank" rel="noopener" class="eco-pill" lang="en">Pay</a>
						<a href="https://docs.modfolio.io" target="_blank" rel="noopener" class="eco-pill" lang="en">Docs</a>
					</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="cta-card reveal" style="--reveal-delay: 0.2s">
					<h2 class="cta-title">일상의 중심을 잡을 준비가 되셨나요?</h2>
					<p class="cta-sub">
						<span lang="en">Modfolio Connect</span> 계정 하나면 충분합니다.
					</p>
					<a href="/auth/login" class="cta-btn">무료로 시작하기</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Base>

<style>
	.hero {
		min-height: 50vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding-top: calc(80px + var(--ls-space-12));
		padding-bottom: var(--ls-space-12);
		background:
			radial-gradient(600px circle at 30% 40%, var(--ls-glow-plum), transparent 60%),
			radial-gradient(400px circle at 70% 60%, var(--ls-glow-sky), transparent 60%),
			var(--ls-void);
	}

	.hero-inner { max-width: 640px; }

	.hero-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-5);
	}

	.hero-lead {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-relaxed);
	}

	.section { padding-block: var(--ls-space-16); }

	.section-raised {
		background: var(--ls-surface-raised);
		border-top: 1px solid var(--ls-border-subtle);
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.section-gradient { background: var(--ls-gradient-soft); }

	/* Mission */
	.mission-card {
		max-width: 800px;
		margin-inline: auto;
		text-align: center;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-12) var(--ls-space-8);
	}

	.mission-label {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		color: var(--ls-text-muted);
		letter-spacing: var(--ls-tracking-widest);
		text-transform: uppercase;
		margin-bottom: var(--ls-space-6);
	}

	.mission-text {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		color: var(--ls-text);
		line-height: var(--ls-leading-snug);
		margin-bottom: var(--ls-space-5);
	}

	.mission-sub {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-md);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
		max-width: 44ch;
		margin-inline: auto;
	}

	/* App cards */
	.center-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-2xl);
		font-weight: 700;
		color: var(--ls-text);
		text-align: center;
		margin-bottom: var(--ls-space-8);
	}

	.app-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--ls-space-6);
		max-width: 860px;
		margin-inline: auto;
	}

	.app-card {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-8);
		transition: transform var(--ls-dur-fast), box-shadow var(--ls-dur-fast);
	}

	.app-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 16px 56px var(--ls-glow-plum);
	}

	.app-name {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-2);
	}

	.app-tagline {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-muted);
		letter-spacing: var(--ls-tracking-wide);
		margin-bottom: var(--ls-space-4);
	}

	.app-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
		margin-bottom: var(--ls-space-5);
	}

	.app-link {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 600;
		color: var(--ls-interactive);
	}

	/* Ecosystem card */
	.eco-card {
		max-width: 800px;
		margin-inline: auto;
		text-align: center;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-10) var(--ls-space-8);
	}

	.eco-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.eco-body {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-md);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
		margin-bottom: var(--ls-space-6);
		max-width: 40ch;
		margin-inline: auto;
	}

	.eco-links {
		display: flex;
		justify-content: center;
		gap: var(--ls-space-3);
		flex-wrap: wrap;
	}

	.eco-pill {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 500;
		color: var(--ls-text-secondary);
		padding: var(--ls-space-2) var(--ls-space-4);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-full);
		transition: color var(--ls-dur-fast), border-color var(--ls-dur-fast), box-shadow var(--ls-dur-fast);
	}

	.eco-pill:hover {
		color: var(--ls-text);
		border-color: var(--ls-interactive);
		box-shadow: 0 4px 16px var(--ls-glow-plum);
	}

	/* CTA card */
	.cta-card {
		max-width: 700px;
		margin-inline: auto;
		text-align: center;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-12) var(--ls-space-8);
	}

	.cta-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.cta-sub {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		color: var(--ls-text-secondary);
		margin-bottom: var(--ls-space-8);
	}

	.cta-btn {
		display: inline-block;
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 600;
		color: #fff;
		padding: var(--ls-space-3) var(--ls-space-8);
		background: var(--ls-gradient);
		background-size: 200% 200%;
		border-radius: var(--ls-r-full);
		transition:
			transform 0.4s var(--ls-ease),
			box-shadow 0.4s var(--ls-ease),
			background-position 0.6s var(--ls-ease-out);
	}

	.cta-btn:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 48px var(--ls-glow-plum);
		background-position: 100% 50%;
	}

	@media (max-width: 640px) {
		.app-grid { grid-template-columns: 1fr; }
	}
</style>
