---
import Footer from "../components/landing/Footer.astro";
import Nav from "../components/shared/Nav.astro";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;
---

<Base title="Blog - Modfolio LS" description="Modfolio LS 그룹의 소식과 이야기.">
	<Nav user={user} current="/blog" />

	<main id="main">
		<section class="hero" aria-labelledby="blog-heading">
			<div class="container hero-inner">
				<h1 id="blog-heading" class="hero-title reveal">블로그</h1>
				<p class="hero-lead reveal" style="--reveal-delay: 0.15s">
					라이프스타일 그룹의 소식과 이야기
				</p>
			</div>
		</section>

		<section class="section section-gradient">
			<div class="container">
				<div class="coming-card reveal" style="--reveal-delay: 0.2s">
					<h2 class="coming-title">준비하고 있습니다</h2>
					<p class="coming-desc">
						여행, 웰니스, 그리고 일상에 대한 이야기를 곧 들려드리겠습니다.
						<span lang="en">Modfolio Press</span> 뉴스레터와 함께
						라이프스타일 인사이트를 전해드릴 예정입니다.
					</p>
				</div>

				<div class="preview-grid">
					<div class="preview-card reveal" style="--reveal-delay: 0.3s">
						<span class="preview-badge">여행</span>
						<div class="preview-skeleton preview-skeleton-title"></div>
						<div class="preview-skeleton"></div>
						<div class="preview-skeleton preview-skeleton-short"></div>
					</div>
					<div class="preview-card reveal" style="--reveal-delay: 0.4s">
						<span class="preview-badge">웰니스</span>
						<div class="preview-skeleton preview-skeleton-title"></div>
						<div class="preview-skeleton"></div>
						<div class="preview-skeleton preview-skeleton-short"></div>
					</div>
					<div class="preview-card reveal" style="--reveal-delay: 0.5s">
						<span class="preview-badge">소식</span>
						<div class="preview-skeleton preview-skeleton-title"></div>
						<div class="preview-skeleton"></div>
						<div class="preview-skeleton preview-skeleton-short"></div>
					</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="cta-card reveal" style="--reveal-delay: 0.2s">
					<h2 class="cta-title">소식을 놓치지 마세요</h2>
					<p class="cta-sub">
						계정을 만들면 새 글이 올라올 때 알림을 받을 수 있습니다.
					</p>
					<a href="/auth/login" class="cta-btn">계정 만들기</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Base>

<style>
	.hero {
		min-height: 40vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding-top: calc(80px + var(--ls-space-12));
		padding-bottom: var(--ls-space-8);
		background:
			radial-gradient(600px circle at 30% 40%, var(--ls-glow-plum), transparent 60%),
			radial-gradient(400px circle at 70% 60%, var(--ls-glow-sky), transparent 60%),
			var(--ls-void);
	}

	.hero-inner { max-width: 640px; }

	.hero-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.hero-lead {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		color: var(--ls-text-secondary);
	}

	.section { padding-block: var(--ls-space-16); }
	.section-gradient { background: var(--ls-gradient-soft); }

	.coming-card {
		max-width: 640px;
		margin-inline: auto;
		text-align: center;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-10) var(--ls-space-8);
		margin-bottom: var(--ls-space-10);
	}

	.coming-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.coming-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-md);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
		max-width: 40ch;
		margin-inline: auto;
	}

	.preview-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--ls-space-5);
		max-width: 960px;
		margin-inline: auto;
	}

	.preview-card {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-lg);
		padding: var(--ls-space-6);
		opacity: 0.6;
	}

	.preview-badge {
		display: inline-block;
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-muted);
		background: var(--ls-surface-raised);
		padding: 2px var(--ls-space-3);
		border-radius: var(--ls-r-sm);
		margin-bottom: var(--ls-space-4);
	}

	.preview-skeleton {
		height: 10px;
		background: var(--ls-surface-overlay);
		border-radius: var(--ls-r-sm);
		margin-bottom: var(--ls-space-2);
	}

	.preview-skeleton-title {
		height: 16px;
		width: 70%;
		margin-bottom: var(--ls-space-4);
	}

	.preview-skeleton-short { width: 45%; }

	.cta-card {
		max-width: 600px;
		margin-inline: auto;
		text-align: center;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-12) var(--ls-space-8);
	}

	.cta-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.cta-sub {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		color: var(--ls-text-secondary);
		margin-bottom: var(--ls-space-8);
	}

	.cta-btn {
		display: inline-block;
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 600;
		color: #fff;
		padding: var(--ls-space-3) var(--ls-space-8);
		background: var(--ls-gradient);
		background-size: 200% 200%;
		border-radius: var(--ls-r-full);
		transition:
			transform 0.4s var(--ls-ease),
			box-shadow 0.4s var(--ls-ease),
			background-position 0.6s var(--ls-ease-out);
	}

	.cta-btn:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 48px var(--ls-glow-plum);
		background-position: 100% 50%;
	}

	@media (max-width: 768px) {
		.preview-grid { grid-template-columns: 1fr; max-width: 360px; }
	}
</style>
