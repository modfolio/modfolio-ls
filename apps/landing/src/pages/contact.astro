---
import Footer from "../components/landing/Footer.astro";
import Nav from "../components/shared/Nav.astro";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;
---

<Base
	title="Contact — Modfolio LS"
	description="Modfolio LS 연락처 및 사업자 정보."
>
	<Nav user={user} current="/contact" />

	<main id="main" class="page">
		<div class="container">
			<section class="contact-hero reveal" aria-labelledby="contact-heading">
				<p class="contact-label" lang="en">Contact</p>
				<h1 id="contact-heading" class="contact-title" lang="en">Contact</h1>
			</section>

			<div class="contact-grid">
				<section class="contact-section reveal" style="--reveal-delay: 0.15s" aria-labelledby="info-heading">
					<h2 id="info-heading" class="section-heading">연락처</h2>
					<dl class="info-list">
						<div class="info-row">
							<dt class="info-label" lang="en">Email</dt>
							<dd class="info-value"><a href="mailto:contact@modfolio.io">contact@modfolio.io</a></dd>
						</div>
						<div class="info-row">
							<dt class="info-label">소재지</dt>
							<dd class="info-value">경기도 수원시 팔달구 효원로 278, 6층 602호</dd>
						</div>
					</dl>
				</section>

				<section class="contact-section reveal" style="--reveal-delay: 0.3s" aria-labelledby="biz-heading">
					<h2 id="biz-heading" class="section-heading">사업자 정보</h2>
					<dl class="info-list">
						<div class="info-row">
							<dt class="info-label">상호</dt>
							<dd class="info-value">모드폴리오</dd>
						</div>
						<div class="info-row">
							<dt class="info-label">대표</dt>
							<dd class="info-value">김동헌</dd>
						</div>
						<div class="info-row">
							<dt class="info-label">사업자등록번호</dt>
							<dd class="info-value">104-95-65636</dd>
						</div>
						<div class="info-row">
							<dt class="info-label">통신판매업</dt>
							<dd class="info-value">제2025-수원팔달-0953호</dd>
						</div>
						<div class="info-row">
							<dt class="info-label">출판사 등록</dt>
							<dd class="info-value">제2024-000037호</dd>
						</div>
						<div class="info-row">
							<dt class="info-label">소재지</dt>
							<dd class="info-value">경기도 수원시 팔달구 효원로 278, 6층 602호</dd>
						</div>
					</dl>
				</section>
			</div>
		</div>
	</main>

	<Footer />
</Base>

<style>
	.page {
		padding-top: calc(80px + var(--ls-space-12));
		padding-bottom: var(--ls-space-16);
	}

	.contact-hero {
		text-align: center;
		margin-bottom: var(--ls-space-12);
	}

	.contact-label {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		color: var(--ls-text-muted);
		letter-spacing: var(--ls-tracking-widest);
		text-transform: uppercase;
		margin-bottom: var(--ls-space-4);
	}

	.contact-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		color: var(--ls-text);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--ls-space-6);
		max-width: 860px;
		margin-inline: auto;
	}

	.contact-section {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-8);
	}

	.section-heading {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		font-weight: 600;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-6);
	}

	.info-list {
		display: flex;
		flex-direction: column;
		gap: var(--ls-space-4);
	}

	.info-row {
		display: flex;
		flex-direction: column;
		gap: var(--ls-space-1);
	}

	.info-label {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		color: var(--ls-text-muted);
		letter-spacing: var(--ls-tracking-wide);
	}

	.info-value {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-base);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
	}

	.info-value a {
		color: var(--ls-interactive);
	}

	@media (max-width: 640px) {
		.contact-grid { grid-template-columns: 1fr; }
	}
</style>
