---
import Footer from "../components/landing/Footer.astro";
import Nav from "../components/shared/Nav.astro";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;

const features = [
	{
		num: "01",
		title: "하나의 계정, 모든 라이프스타일",
		body: "Modfolio Connect로 KeepNBuild와 Worthee 모두 이용. 하나의 인증으로 모든 도구에 접근하세요.",
	},
	{
		num: "02",
		title: "흩어진 일상이 하나의 그림으로",
		body: "독립적인 앱이지만 하나의 프로필. 여행 기록과 습관 데이터가 함께 일상의 그림을 완성합니다.",
	},
	{
		num: "03",
		title: "당신의 데이터, 당신의 것",
		body: "암호화 보관, 언제든 내보내기 가능. 삭제 요청 시 30일 이내 완전 제거됩니다.",
	},
];
---

<Base title="Features - Modfolio LS" description="Modfolio LS의 핵심 기능.">
	<Nav user={user} current="/features" />

	<main id="main">
		<section class="hero" aria-labelledby="features-heading">
			<div class="container hero-inner">
				<h1 id="features-heading" class="hero-title reveal">
					왜 <span class="gradient-text" lang="en">Modfolio LS</span>인가
				</h1>
				<p class="hero-lead reveal" style="--reveal-delay: 0.15s">
					세 가지 핵심 가치가 당신의 라이프스타일을 바꿉니다.
				</p>
			</div>
		</section>

		<section class="section section-raised">
			<div class="container">
				<div class="feature-grid">
					{features.map((f, i) => (
						<div class="feature-card reveal" style={`--reveal-delay: ${(i + 1) * 0.15}s`}>
							<span class="feature-num gradient-text">{f.num}</span>
							<h2 class="feature-title">{f.title}</h2>
							<p class="feature-body">{f.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<h2 class="center-title reveal">
					<span class="gradient-text" lang="en">Modfolio LS</span>로 달라지는 것
				</h2>
				<div class="compare-grid">
					<div class="compare-card compare-before reveal" style="--reveal-delay: 0.15s">
						<h3 class="compare-label">Before</h3>
						<ul class="compare-list">
							<li>여행 앱 따로, 습관 앱 따로</li>
							<li>각각 다른 계정으로 로그인</li>
							<li>데이터가 흩어져 관리 불가</li>
						</ul>
					</div>
					<div class="compare-card compare-after reveal" style="--reveal-delay: 0.3s">
						<h3 class="compare-label">After</h3>
						<ul class="compare-list">
							<li>하나의 포탈에서 모든 라이프스타일</li>
							<li>SSO 한 번 로그인으로 전부 접근</li>
							<li>내 데이터, 내가 소유하고 내보내기</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="section section-gradient">
			<div class="container">
				<div class="cta-card reveal" style="--reveal-delay: 0.2s">
					<h2 class="cta-title">지금 시작해보세요</h2>
					<p class="cta-sub">
						<span lang="en">Modfolio Connect</span> 계정 하나면 충분합니다.
					</p>
					<a href="/auth/login" class="cta-btn">무료로 시작하기</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Base>

<style>
	.hero {
		min-height: 50vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding-top: calc(80px + var(--ls-space-12));
		padding-bottom: var(--ls-space-12);
		background:
			radial-gradient(600px circle at 30% 40%, var(--ls-glow-plum), transparent 60%),
			radial-gradient(400px circle at 70% 60%, var(--ls-glow-sky), transparent 60%),
			var(--ls-void);
	}

	.hero-inner { max-width: 640px; }

	.hero-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-5);
	}

	.hero-lead {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		color: var(--ls-text-secondary);
	}

	.section { padding-block: var(--ls-space-16); }

	.section-raised {
		background: var(--ls-surface-raised);
		border-top: 1px solid var(--ls-border-subtle);
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.section-gradient { background: var(--ls-gradient-soft); }

	.center-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-2xl);
		font-weight: 700;
		color: var(--ls-text);
		text-align: center;
		margin-bottom: var(--ls-space-10);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--ls-space-6);
		max-width: 1080px;
		margin-inline: auto;
	}

	.feature-card {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-8);
		text-align: center;
		transition: transform var(--ls-dur-fast), box-shadow var(--ls-dur-fast);
	}

	.feature-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 16px 56px var(--ls-glow-plum);
	}

	.feature-num {
		display: block;
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-4xl);
		font-weight: 700;
		line-height: 1;
		margin-bottom: var(--ls-space-5);
	}

	.feature-title {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		font-weight: 600;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.feature-body {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-base);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
		max-width: 28ch;
		margin-inline: auto;
	}

	.compare-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--ls-space-6);
		max-width: 860px;
		margin-inline: auto;
	}

	.compare-card {
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-8);
		transition: transform var(--ls-dur-fast), box-shadow var(--ls-dur-fast);
	}

	.compare-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--ls-shadow-md);
	}

	.compare-before {
		background: var(--ls-surface-overlay);
		border: 1px solid var(--ls-border);
	}

	.compare-after {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		box-shadow: var(--ls-shadow-sm);
	}

	.compare-label {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 700;
		margin-bottom: var(--ls-space-5);
	}

	.compare-before .compare-label { color: var(--ls-text-muted); }
	.compare-after .compare-label { color: var(--ls-interactive); }

	.compare-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--ls-space-3);
	}

	.compare-list li {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-base);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
		padding-left: var(--ls-space-4);
		position: relative;
	}

	.compare-list li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
	}

	.compare-before .compare-list li::before { background: var(--ls-text-muted); }
	.compare-after .compare-list li::before { background: var(--ls-interactive); }

	.cta-card {
		max-width: 700px;
		margin-inline: auto;
		text-align: center;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-12) var(--ls-space-8);
	}

	.cta-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.cta-sub {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		color: var(--ls-text-secondary);
		margin-bottom: var(--ls-space-8);
	}

	.cta-btn {
		display: inline-block;
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 600;
		color: #fff;
		padding: var(--ls-space-3) var(--ls-space-8);
		background: var(--ls-gradient);
		background-size: 200% 200%;
		border-radius: var(--ls-r-full);
		transition:
			transform 0.4s var(--ls-ease),
			box-shadow 0.4s var(--ls-ease),
			background-position 0.6s var(--ls-ease-out);
	}

	.cta-btn:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 48px var(--ls-glow-plum);
		background-position: 100% 50%;
	}

	@media (max-width: 768px) {
		.feature-grid { grid-template-columns: 1fr; max-width: 420px; }
		.compare-grid { grid-template-columns: 1fr; }
	}
</style>
