---
import Footer from "../../components/landing/Footer.astro";
import Nav from "../../components/shared/Nav.astro";
import Base from "../../layouts/Base.astro";

const user = Astro.locals.user;

const features = [
	{
		title: "매일의 기록",
		body: "운동, 독서, 명상. 형식은 자유롭게, 기록은 꾸준히. 작은 실천이 모여 하나의 흐름이 됩니다.",
	},
	{
		title: "과정의 인증",
		body: "기록만으로 끝나지 않습니다. 사진, 데이터, 타임스탬프로 과정을 남기고 투명하게 공개합니다.",
	},
	{
		title: "선명한 궤적",
		body: "함께 인증합니다. 혼자만의 다짐이 선명한 궤적이 됩니다.",
	},
];
---

<Base
	title="Worthee — Modfolio LS"
	description="매일의 실천을 기록하고 함께 인증합니다. 꾸준함을 눈에 보이게."
>
	<Nav user={user} current="/apps" />

	<main id="main">
		<section class="hero" aria-labelledby="worthee-heading">
			<div class="container hero-inner">
				<nav class="breadcrumb reveal" aria-label="현재 위치">
					<a href="/" lang="en">LS</a>
					<span aria-hidden="true">&rarr;</span>
					<a href="/apps" lang="en">Apps</a>
					<span aria-hidden="true">&rarr;</span>
					<span lang="en">Worthee</span>
				</nav>
				<h1 id="worthee-heading" class="hero-title reveal" style="--reveal-delay: 0.1s">
					꾸준함을 눈에 보이게.
				</h1>
				<p class="hero-sub reveal" style="--reveal-delay: 0.2s">
					매일의 실천을 기록하고 함께 인증하는 셀프 매니지먼트.
				</p>
				<div class="hero-actions reveal" style="--reveal-delay: 0.3s">
					<a href="https://worthee.io" target="_blank" rel="noopener" class="btn-gradient" lang="en">worthee.io 방문</a>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="feature-grid">
					{features.map((f, i) => (
						<div class="feature-card reveal" style={`--reveal-delay: ${(i + 1) * 0.15}s`}>
							<h2 class="feature-title">{f.title}</h2>
							<p class="feature-body">{f.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section section-gradient">
			<div class="container">
				<div class="cta-card reveal" style="--reveal-delay: 0.2s">
					<p class="cta-body">꾸준함을 눈에 보이게.</p>
					<a href="https://worthee.io" target="_blank" rel="noopener" class="btn-gradient" lang="en">worthee.io</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Base>

<style>
	.hero {
		min-height: 50vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding-top: calc(80px + var(--ls-space-12));
		padding-bottom: var(--ls-space-8);
		background:
			radial-gradient(600px circle at 30% 40%, var(--ls-glow-plum), transparent 60%),
			radial-gradient(400px circle at 70% 60%, var(--ls-glow-sky), transparent 60%),
			var(--ls-void);
	}

	.hero-inner { max-width: 640px; }

	.breadcrumb {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--ls-space-2);
		margin-bottom: var(--ls-space-6);
	}

	.breadcrumb a {
		color: var(--ls-text-muted);
		transition: color var(--ls-dur-fast);
	}

	.breadcrumb a:hover { color: var(--ls-interactive); }

	.hero-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.hero-sub {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		color: var(--ls-text-secondary);
		margin-bottom: var(--ls-space-8);
	}

	.section { padding-block: var(--ls-space-16); }
	.section-gradient {
		background: var(--ls-gradient-soft);
		padding-block: var(--ls-space-12);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--ls-space-6);
		max-width: 1080px;
		margin-inline: auto;
	}

	.feature-card {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border-ghost);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-8);
		transition: transform var(--ls-dur-fast), box-shadow var(--ls-dur-fast);
	}

	.feature-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 16px 56px var(--ls-glow-plum);
	}

	.feature-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-lg);
		font-weight: 600;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.feature-body {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-base);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-relaxed);
	}

	.cta-card {
		max-width: 600px;
		margin-inline: auto;
		text-align: center;
	}

	.cta-body {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-5);
	}

	@media (max-width: 768px) {
		.feature-grid { grid-template-columns: 1fr; max-width: 420px; }
	}
</style>
