---
const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
	<div class="container container-wide footer-inner">
		<div class="footer-grid">
			<div class="footer-col">
				<p class="footer-brand gradient-text" lang="en">Modfolio LS</p>
				<p class="footer-tagline">라이프스타일 그룹</p>
			</div>

			<div class="footer-col">
				<h3 class="footer-heading">서비스</h3>
				<ul class="footer-list">
					<li><a href="https://keepnbuild.com" target="_blank" rel="noopener" lang="en">KeepNBuild</a></li>
					<li><a href="https://worthee.io" target="_blank" rel="noopener" lang="en">Worthee</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h3 class="footer-heading">생태계</h3>
				<ul class="footer-list">
					<li><a href="https://modfolio.io" target="_blank" rel="noopener" lang="en">Modfolio</a></li>
					<li><a href="https://connect.modfolio.io" target="_blank" rel="noopener" lang="en">Connect</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h3 class="footer-heading">법률</h3>
				<ul class="footer-list">
					<li><a href="https://modfolio.io/privacy">개인정보</a></li>
					<li><a href="https://modfolio.io/terms">이용약관</a></li>
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<p class="footer-copy">&copy; {year} Modfolio Inc.</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		z-index: 1;
		border-top: 1px solid var(--ls-border);
		padding-block: var(--ls-space-10) var(--ls-space-6);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr repeat(3, 1fr);
		gap: var(--ls-space-8);
		margin-bottom: var(--ls-space-8);
	}

	@media (max-width: 768px) { .footer-grid { grid-template-columns: repeat(2, 1fr); gap: var(--ls-space-6); } }
	@media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }

	.footer-brand {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-lg);
		font-weight: 700;
		margin-bottom: var(--ls-space-2);
	}

	.footer-tagline {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-muted);
	}

	.footer-heading {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		color: var(--ls-text-muted);
		margin-bottom: var(--ls-space-4);
	}

	.footer-list { list-style: none; display: flex; flex-direction: column; gap: var(--ls-space-3); }
	.footer-list a {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		transition: color var(--ls-dur-fast);
	}
	.footer-list a:hover { color: var(--ls-interactive); }

	.footer-bottom { border-top: 1px solid var(--ls-border-subtle); padding-top: var(--ls-space-5); }
	.footer-copy { font-family: var(--ls-font-story); font-size: var(--ls-text-xs); color: var(--ls-text-muted); }
</style>
