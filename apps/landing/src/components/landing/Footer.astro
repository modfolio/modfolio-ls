</footer>

<style>
	.footer {
		position: relative;
		z-index: 1;
		border-top: 1px solid var(--ls-border);
	}

	.footer-main {
		padding-block: var(--ls-space-12);
	}

	.footer-inner,
	.footer-legal-inner {
		max-width: var(--ls-content-wide);
		margin-inline: auto;
		padding-inline: clamp(1rem, 4vw, 2rem);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr repeat(3, 1fr);
		gap: var(--ls-space-8);
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--ls-space-6);
		}
	}
	@media (max-width: 480px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}

	.footer-brand {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		margin-bottom: var(--ls-space-2);
	}

	.footer-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-muted);
		margin-bottom: var(--ls-space-5);
	}

	.footer-sns {
		display: flex;
		gap: var(--ls-space-4);
	}

	.footer-sns a {
		color: var(--ls-text-muted);
		transition: color var(--ls-dur-fast);
	}

	.footer-sns a:hover {
		color: var(--ls-interactive);
	}

	.footer-heading {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		color: var(--ls-text-muted);
		text-transform: uppercase;
		letter-spacing: var(--ls-tracking-wide);
		margin-bottom: var(--ls-space-4);
	}

	.footer-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--ls-space-3);
	}

	.footer-list a {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		transition: color var(--ls-dur-fast);
	}

	.footer-list a:hover {
		color: var(--ls-interactive);
	}

	.footer-legal {
		border-top: 1px solid var(--ls-border-subtle);
		padding-block: var(--ls-space-4);
	}

	.footer-legal-inner {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: var(--ls-space-6);
	}

	.footer-biz {
		font-family: var(--ls-font-story);
		font-size: 0.6875rem;
		color: var(--ls-text-muted);
		line-height: 1.9;
		word-break: keep-all;
		flex: 1;
		min-width: 0;
	}

	.footer-copy {
		font-family: var(--ls-font-story);
		font-size: 0.6875rem;
		color: var(--ls-text-muted);
		white-space: nowrap;
		flex-shrink: 0;
	}

	@media (max-width: 768px) {
		.footer-legal-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--ls-space-3);
		}
	}
</style>
