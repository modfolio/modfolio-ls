---
const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
	<div class="footer-main">
		<div class="footer-inner">
			<div class="footer-grid">
				<!-- Brand -->
				<div class="footer-col footer-col-brand">
					<p class="footer-brand gradient-text" lang="en">Modfolio LS</p>
					<p class="footer-desc" lang="en">Life, Unfolded</p>
				</div>

				<!-- Products -->
				<div class="footer-col">
					<h3 class="footer-heading" lang="en">Products</h3>
					<ul class="footer-list">
						<li><a href="https://keepnbuild.com" target="_blank" rel="noopener" lang="en">KeepNBuild</a></li>
						<li><a href="https://worthee.io" target="_blank" rel="noopener" lang="en">Worthee</a></li>
					</ul>
				</div>

				<!-- Platform -->
				<div class="footer-col">
					<h3 class="footer-heading" lang="en">Platform</h3>
					<ul class="footer-list">
						<li><a href="https://connect.modfolio.io" target="_blank" rel="noopener" lang="en">Connect</a></li>
						<li><a href="https://pay.modfolio.io" target="_blank" rel="noopener" lang="en">Pay</a></li>
						<li><a href="https://docs.modfolio.io" target="_blank" rel="noopener" lang="en">Docs</a></li>
					</ul>
				</div>

				<!-- Ecosystem -->
				<div class="footer-col">
					<h3 class="footer-heading" lang="en">Ecosystem</h3>
					<ul class="footer-list">
						<li><a href="https://works.modfolio.io" target="_blank" rel="noopener" lang="en">Works</a></li>
						<li><a href="/" lang="en">LS</a></li>
						<li><a href="https://axiom.modfolio.io" target="_blank" rel="noopener" lang="en">Axiom</a></li>
						<li><a href="https://studio.modfolio.io" target="_blank" rel="noopener" lang="en">Studio</a></li>
					</ul>
				</div>

				<!-- Legal -->
				<div class="footer-col">
					<h3 class="footer-heading" lang="en">Legal</h3>
					<ul class="footer-list">
						<li><a href="/privacy">개인정보처리방침</a></li>
						<li><a href="/terms">이용약관</a></li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<div class="footer-legal">
		<div class="footer-legal-inner">
			<p class="footer-biz">모드폴리오 &middot; 대표 김동헌 &middot; 사업자등록번호 104-95-65636 &middot; 통신판매업 제2025-수원팔달-0953호 &middot; 출판사 제2024-000037호 &middot; 경기도 수원시 팔달구 효원로 278, 6층 602호 &middot; contact@modfolio.io</p>
			<p class="footer-copy">&copy; {year} Modfolio. All rights reserved.</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		z-index: 1;
		border-top: 1px solid var(--ls-border);
	}

	.footer-main {
		padding-block: var(--ls-space-12);
	}

	.footer-inner,
	.footer-legal-inner {
		max-width: var(--ls-content-wide);
		margin-inline: auto;
		padding-inline: var(--ls-content-gutter);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr repeat(4, 1fr);
		gap: var(--ls-space-8);
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--ls-space-6);
		}

		.footer-col-brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 480px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}

	.footer-brand {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		margin-bottom: var(--ls-space-2);
	}

	.footer-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-muted);
	}

	.footer-heading {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		color: var(--ls-text-muted);
		text-transform: uppercase;
		letter-spacing: var(--ls-tracking-wide);
		margin-bottom: var(--ls-space-4);
	}

	.footer-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--ls-space-3);
	}

	.footer-list a {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		transition: color var(--ls-dur-fast);
	}

	.footer-list a:hover {
		color: var(--ls-interactive);
	}

	.footer-legal {
		border-top: 1px solid var(--ls-border-subtle);
		padding-block: var(--ls-space-4);
	}

	.footer-legal-inner {
		display: flex;
		flex-direction: column;
		gap: var(--ls-space-2);
	}

	.footer-biz {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-legal-size);
		color: var(--ls-text-muted);
		line-height: 1.7;
		letter-spacing: -0.01em;
	}

	.footer-copy {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-legal-size);
		color: var(--ls-text-muted);
	}
</style>
