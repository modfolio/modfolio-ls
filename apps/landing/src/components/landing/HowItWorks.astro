---
const steps = [
	{
		num: "01",
		title: "계정 하나면 됩니다",
		body: "Modfolio Connect로 로그인하세요.\n별도 가입 없이 모든 LS 앱에 접근합니다.",
	},
	{
		num: "02",
		title: "마음이 가는 경험을\n고르세요",
		body: "여행, 자기관리.\n각각 독립된 앱이지만\n하나의 계정 안에 있습니다.",
	},
	{
		num: "03",
		title: "바로 시작",
		body: "설치도, 대기도 없습니다.\n브라우저를 열면\n이미 준비되어 있습니다.",
	},
];
---

<section class="how" aria-labelledby="how-heading">
	<div class="container">
		<h2 id="how-heading" class="how-title reveal">
			시작하는 데<br />5분이면 됩니다.
		</h2>

		<div class="how-grid">
			{steps.map((s, i) => (
				<div class="how-step reveal" style={`--reveal-delay: ${(i + 1) * 0.12}s`}>
					<span class="how-num">{s.num}</span>
					<h3 class="how-heading">{s.title.split("\n").map((line, j) => (
						<>{j > 0 && <br />}{line}</>
					))}</h3>
					<p class="how-desc">{s.body.split("\n").map((line, j) => (
						<>{j > 0 && <br />}{line}</>
					))}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.how {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-20);
		background: var(--ls-void);
	}

	.how-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		color: var(--ls-text);
		text-align: center;
		line-height: var(--ls-leading-tight);
		margin-bottom: var(--ls-space-12);
	}

	.how-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--ls-space-8);
		max-width: 1080px;
		margin-inline: auto;
	}

	.how-step {
		padding-top: var(--ls-space-5);
		border-top: 1px solid var(--ls-border-ghost);
	}

	.how-num {
		display: block;
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		color: var(--ls-text-muted);
		letter-spacing: var(--ls-tracking-wide);
		margin-bottom: var(--ls-space-4);
	}

	.how-heading {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		font-weight: 600;
		color: var(--ls-text);
		line-height: var(--ls-leading-snug);
		margin-bottom: var(--ls-space-4);
	}

	.how-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-base);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
	}

	@media (max-width: 768px) {
		.how-grid {
			grid-template-columns: 1fr;
			max-width: 420px;
		}
	}
</style>
