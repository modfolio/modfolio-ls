---
const apps = [
	{
		id: "keepnbuild",
		name: "KeepNBuild",
		href: "/apps/keepnbuild",
		domain: "keepnbuild.com",
		lead: "당신만의 여정을\n직접 그리세요.",
		desc: "패키지 안에 없는 여행을 만들고 기록합니다.",
	},
	{
		id: "worthee",
		name: "Worthee",
		href: "/apps/worthee",
		domain: "worthee.io",
		lead: "꾸준함이\n빛나는 순간.",
		desc: "매일의 실천을 기록하고, 커뮤니티가 함께 확인합니다.",
	},
];
---

<section class="portfolio" id="portfolio" aria-labelledby="portfolio-heading">
	<div class="container">
		<p class="portfolio-eyebrow reveal" lang="en">Portfolio</p>
		<h2 id="portfolio-heading" class="portfolio-title reveal" style="--reveal-delay: 0.1s">
			우리가 만드는 것.
		</h2>

		<div class="portfolio-list">
			{apps.map((app, i) => (
				<a
					href={app.href}
					class="portfolio-item reveal"
					data-app={app.id}
					style={`--reveal-delay: ${(i + 1) * 0.15}s`}
				>
					<div class="portfolio-header">
						<h3 class="portfolio-name" lang="en">{app.name}</h3>
						<span class="portfolio-domain" lang="en">{app.domain}</span>
					</div>
					<p class="portfolio-lead">{app.lead.split("\n").map((line, j) => (
						<>{j > 0 && <br />}{line}</>
					))}</p>
					<p class="portfolio-desc">{app.desc}</p>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.portfolio {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-20);
		background: var(--ls-surface-raised);
		border-top: 1px solid var(--ls-border-subtle);
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.portfolio-eyebrow {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		color: var(--ls-text-muted);
		letter-spacing: var(--ls-tracking-widest);
		text-transform: uppercase;
		margin-bottom: var(--ls-space-4);
	}

	.portfolio-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-12);
	}

	.portfolio-list {
		max-width: 860px;
	}

	.portfolio-item {
		display: block;
		padding: var(--ls-space-10) 0;
		border-top: 1px solid var(--ls-border-subtle);
		transition: background-color var(--ls-dur-fast) var(--ls-ease);
	}

	.portfolio-item:last-child {
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.portfolio-item:hover {
		background-color: var(--ls-surface);
		padding-inline: var(--ls-space-6);
		margin-inline: calc(-1 * var(--ls-space-6));
		border-radius: var(--ls-r-lg);
	}

	.portfolio-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: var(--ls-space-5);
	}

	.portfolio-name {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-2xl);
		font-weight: 700;
		color: var(--ls-text);
	}

	.portfolio-domain {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 500;
		color: var(--ls-text-muted);
		letter-spacing: var(--ls-tracking-wide);
	}

	.portfolio-lead {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-lg);
		font-weight: 600;
		color: var(--ls-text);
		line-height: var(--ls-leading-snug);
		margin-bottom: var(--ls-space-3);
	}

	.portfolio-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
	}

	@media (max-width: 768px) {
		.portfolio-header {
			flex-direction: column;
			gap: var(--ls-space-1);
		}
	}
</style>
