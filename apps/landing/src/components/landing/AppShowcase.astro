---
const apps = [
	{
		id: "keepnbuild",
		name: "KeepNBuild",
		url: "https://keepnbuild.com",
		lead: "당신만의 여행을 직접 설계하세요.",
		desc: "일정을 만들고, 경험을 기록하고, 다음 여행을 미리 그려보세요.",
	},
	{
		id: "worthee",
		name: "Worthee",
		url: "https://worthee.io",
		lead: "성실함이 증명되는 순간을 경험하세요.",
		desc: "매일 습관을 기록하고 인증하면, 커뮤니티가 검증합니다.",
	},
];
---

<section class="showcase reveal" id="showcase" aria-labelledby="showcase-heading">
	<div class="container">
		<h2 id="showcase-heading" class="showcase-title reveal">
			두 가지 <span class="gradient-text">라이프스타일</span> 도구
		</h2>

		<div class="showcase-grid">
			{apps.map((app, i) => (
				<a
					href={app.url}
					class="showcase-card reveal"
					data-app={app.id}

					target="_blank"
					rel="noopener"
					style={`--reveal-delay: ${(i + 1) * 0.15}s`}
				>
					<h3 class="showcase-name" lang="en">{app.name}</h3>
					<p class="showcase-lead">{app.lead}</p>
					<p class="showcase-desc">{app.desc}</p>
					<span class="showcase-link" lang="en">{app.name} &rarr;</span>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.showcase {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-12) var(--ls-space-16);
	}

	.showcase-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		color: var(--ls-text);
		text-align: center;
		margin-bottom: var(--ls-space-10);
	}

	.showcase-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: var(--ls-space-6);
	}

	.showcase-card {
		display: block;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-10);
		transition:
			transform 0.4s var(--ls-ease),
			box-shadow 0.4s var(--ls-ease),
			border-color 0.3s var(--ls-ease);
		will-change: transform;
	}

	.showcase-card:hover {
		transform: translateY(-6px) scale(1.01);
		border-color: var(--ls-border-hover);
		box-shadow: 0 16px 56px var(--ls-glow-plum);
	}

	.showcase-name {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.showcase-lead {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		color: var(--ls-text);
		font-weight: 500;
		line-height: var(--ls-leading-snug);
		margin-bottom: var(--ls-space-3);
	}

	.showcase-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
		margin-bottom: var(--ls-space-6);
	}

	.showcase-link {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 600;
		background: var(--ls-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
</style>
