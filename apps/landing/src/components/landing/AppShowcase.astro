---
/* FBO Framework: Feature - Benefit - Outcome (lead with Outcome) */
const showcaseData = [
	{
		id: "keepnbuild",
		name: "KeepNBuild",
		landingUrl: "https://keepnbuild.com",
		badge: "TRAVEL DESIGN",
		outcome: "Craft your perfect journey.",
		detail:
			"Design itineraries, record experiences, and envision your next trip.",
		cta: "Start Designing",
	},
	{
		id: "worthee",
		name: "Worthee",
		landingUrl: "https://worthee.io",
		badge: "HONOR & HABITS",
		outcome: "Experience the moment your effort is proven.",
		detail:
			"Log daily habits and verify them. Your community validates, and you earn honor badges.",
		cta: "Start Building",
	},
];
---

<section class="showcase reveal" id="showcase" aria-labelledby="showcase-heading">
	<div class="container">
		<span class="section-label" lang="en">DISCOVER</span>
		<h2 id="showcase-heading" class="section-heading">Two lifestyle tools</h2>

		<div class="showcase-grid">
			{showcaseData.map((item, i) => (
				<article
					class="showcase-card reveal"
					data-app={item.id}
					style={`--reveal-delay: ${(i + 1) * 0.15}s`}
				>
					<div class="showcase-card-accent" aria-hidden="true" />
					<div class="showcase-card-content">
						<span class="showcase-badge" lang="en">{item.badge}</span>
						<h3 class="showcase-name" lang="en">{item.name}</h3>
						<p class="showcase-outcome">{item.outcome}</p>
						<p class="showcase-detail">{item.detail}</p>
						<a href={item.landingUrl} class="showcase-link" target="_blank" rel="noopener">
							{item.cta} &rarr;
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.showcase {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-12);
	}

	.showcase-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: var(--ls-space-5);
	}

	.showcase-card {
		position: relative;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-lg);
		overflow: hidden;
		transition:
			transform var(--ls-dur-fast) var(--ls-ease),
			box-shadow var(--ls-dur-fast) var(--ls-ease);
	}

	.showcase-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--ls-shadow-md);
	}

	.showcase-card-accent {
		height: 3px;
		background: var(--ls-app-accent, var(--ls-interactive));
	}

	.showcase-card-content {
		padding: var(--ls-space-6);
	}

	.showcase-badge {
		display: inline-block;
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		letter-spacing: var(--ls-tracking-widest);
		color: var(--ls-app-accent, var(--ls-interactive));
		margin-bottom: var(--ls-space-3);
	}

	.showcase-name {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-xl);
		font-weight: 700;
		line-height: var(--ls-leading-snug);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.showcase-outcome {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		color: var(--ls-text);
		font-weight: 500;
		line-height: var(--ls-leading-snug);
		margin-bottom: var(--ls-space-3);
	}

	.showcase-detail {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
		margin-bottom: var(--ls-space-5);
	}

	.showcase-link {
		display: inline-flex;
		align-items: center;
		gap: var(--ls-space-2);
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 600;
		color: var(--ls-app-accent, var(--ls-interactive));
		transition: opacity var(--ls-dur-fast) var(--ls-ease);
	}

	.showcase-link:hover {
		opacity: 0.75;
	}
</style>
