---
const pillars = [
	{
		num: "01",
		title: "하나의 계정, 모든 라이프스타일",
		desc: "Modfolio Connect 하나로 여행 설계와 자기관리를 모두.",
	},
	{
		num: "02",
		title: "흩어진 일상이 하나로",
		desc: "각 앱은 독립적이지만, 당신의 데이터는 하나의 그림이 됩니다.",
	},
	{
		num: "03",
		title: "당신의 데이터, 당신의 것",
		desc: "모든 데이터는 암호화되며, 언제든 내보낼 수 있습니다.",
	},
];
---

<section class="value reveal" aria-labelledby="value-heading">
	<div class="container">
		<h2 id="value-heading" class="value-title reveal">
			왜 <span class="gradient-text" lang="en">Modfolio LS</span>인가
		</h2>

		<div class="value-list">
			{pillars.map((p, i) => (
				<div class="value-item reveal" style={`--reveal-delay: ${(i + 1) * 0.12}s`}>
					<span class="value-num gradient-text">{p.num}</span>
					<div class="value-body">
						<h3 class="value-heading">{p.title}</h3>
						<p class="value-desc">{p.desc}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.value {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-12) var(--ls-space-16);
	}

	.value-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-2xl);
		font-weight: 700;
		color: var(--ls-text);
		text-align: center;
		margin-bottom: var(--ls-space-10);
	}

	.value-list {
		display: flex;
		flex-direction: column;
		gap: var(--ls-space-8);
		max-width: 640px;
		margin-inline: auto;
	}

	.value-item {
		display: flex;
		gap: var(--ls-space-5);
		align-items: flex-start;
	}

	.value-num {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-2xl);
		font-weight: 700;
		line-height: 1;
		flex-shrink: 0;
	}

	.value-heading {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		font-weight: 600;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-2);
	}

	.value-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
	}

	@media (max-width: 480px) {
		.value-item {
			flex-direction: column;
			gap: var(--ls-space-3);
		}
	}
</style>
