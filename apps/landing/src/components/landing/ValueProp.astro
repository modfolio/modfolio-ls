---
/* AIDA Interest/Desire: 3 value pillars — geometric icons, no emoji */
const pillars = [
	{
		title: "One account, all lifestyle",
		desc: "Access KeepNBuild and Worthee with a single Modfolio Connect account.",
		geo: "circle",
	},
	{
		title: "From travel to habits, connected",
		desc: "Each app is independent, but your data forms one lifestyle picture.",
		geo: "rings",
	},
	{
		title: "Your data, your ownership",
		desc: "All data is encrypted and exportable at any time.",
		geo: "shield",
	},
];
---

<section class="value reveal" aria-labelledby="value-heading">
	<div class="container">
		<span class="section-label" lang="en">WHY MODFOLIO LS</span>
		<h2 id="value-heading" class="section-heading">A new standard for lifestyle</h2>

		<div class="value-grid">
			{pillars.map((p, i) => (
				<div class="value-card reveal" style={`--reveal-delay: ${(i + 1) * 0.12}s`}>
					<div class={`value-icon value-icon--${p.geo}`} aria-hidden="true">
						<span class="value-icon-shape" />
					</div>
					<h3 class="value-title">{p.title}</h3>
					<p class="value-desc">{p.desc}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.value {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-12);
	}

	.value-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--ls-space-5);
	}

	.value-card {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-lg);
		padding: var(--ls-space-6);
		transition:
			transform var(--ls-dur-fast) var(--ls-ease),
			box-shadow var(--ls-dur-fast) var(--ls-ease);
	}

	.value-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--ls-shadow-md);
	}

	/* Geometric icons */
	.value-icon {
		width: 40px;
		height: 40px;
		margin-bottom: var(--ls-space-4);
		position: relative;
	}

	.value-icon--circle .value-icon-shape {
		display: block;
		width: 32px;
		height: 32px;
		border: 2px solid var(--ls-interactive);
		border-radius: 50%;
	}

	.value-icon--rings .value-icon-shape {
		display: block;
		width: 28px;
		height: 28px;
		border: 2px solid var(--ls-interactive);
		border-radius: 50%;
	}

	.value-icon--rings .value-icon-shape::after {
		content: "";
		position: absolute;
		top: 8px;
		left: 8px;
		width: 16px;
		height: 16px;
		border: 1.5px solid var(--ls-interactive);
		border-radius: 50%;
		opacity: 0.5;
	}

	.value-icon--shield .value-icon-shape {
		display: block;
		width: 26px;
		height: 30px;
		border: 2px solid var(--ls-interactive);
		border-radius: 4px 4px 50% 50%;
	}

	.value-title {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		font-weight: 600;
		line-height: var(--ls-leading-snug);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-3);
	}

	.value-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
	}
</style>
