---
const pillars = [
	{
		num: "01",
		title: "하나의 계정, 모든 라이프스타일",
		desc: "Modfolio Connect 하나로 여행 설계와 자기관리를 모두.",
	},
	{
		num: "02",
		title: "흩어진 일상이 하나로",
		desc: "각 앱은 독립적이지만, 당신의 데이터는 하나의 그림이 됩니다.",
	},
	{
		num: "03",
		title: "당신의 데이터, 당신의 것",
		desc: "모든 데이터는 암호화되며, 언제든 내보낼 수 있습니다.",
	},
];
---

<section class="value" aria-labelledby="value-heading">
	<div class="container">
		<h2 id="value-heading" class="value-title reveal">
			왜 <span class="gradient-text" lang="en">Modfolio LS</span>인가
		</h2>

		<div class="value-grid">
			{pillars.map((p, i) => (
				<div class="value-card reveal" style={`--reveal-delay: ${(i + 1) * 0.12}s`}>
					<span class="value-num gradient-text">{p.num}</span>
					<h3 class="value-heading">{p.title}</h3>
					<p class="value-desc">{p.desc}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.value {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-16);
		min-height: 80vh;
		display: flex;
		align-items: center;
		background: var(--ls-surface-raised);
		border-top: 1px solid var(--ls-border-subtle);
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.value-title {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		color: var(--ls-text);
		text-align: center;
		margin-bottom: var(--ls-space-12);
	}

	.value-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--ls-space-6);
		max-width: 1080px;
		margin-inline: auto;
	}

	.value-card {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-8);
		text-align: center;
		transition:
			transform var(--ls-dur-fast) var(--ls-ease),
			box-shadow var(--ls-dur-fast) var(--ls-ease);
	}

	.value-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 16px 56px var(--ls-glow-plum);
	}

	.value-num {
		display: block;
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-4xl);
		font-weight: 700;
		line-height: 1;
		margin-bottom: var(--ls-space-5);
	}

	.value-heading {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		font-weight: 600;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.value-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-base);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
	}

	@media (max-width: 768px) {
		.value-grid {
			grid-template-columns: 1fr;
			max-width: 420px;
		}
	}
</style>
