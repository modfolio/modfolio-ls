---
---

<section class="cta reveal" aria-labelledby="cta-heading">
	<div class="cta-wash" aria-hidden="true"></div>
	<div class="container cta-inner">
		<h2 id="cta-heading" class="cta-heading">
			오늘, 일상의 중심을 잡으세요.
		</h2>
		<p class="cta-sub">
			<span lang="en">Modfolio Connect</span> 계정 하나면 충분합니다.
		</p>
		<a href="/auth/login" class="cta-btn">무료로 시작하기</a>
	</div>
</section>

<style>
	.cta {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-16);
		overflow: hidden;
	}

	.cta-wash {
		position: absolute;
		inset: 0;
		background: var(--ls-gradient-soft);
		pointer-events: none;
	}

	.cta-inner {
		position: relative;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.cta-heading {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-2xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.cta-sub {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-md);
		color: var(--ls-text-secondary);
		margin-bottom: var(--ls-space-8);
	}

	.cta-btn {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 600;
		color: #fff;
		padding: var(--ls-space-3) var(--ls-space-8);
		background: var(--ls-gradient);
		border-radius: var(--ls-r-full);
		transition:
			transform var(--ls-dur-fast) var(--ls-ease),
			box-shadow var(--ls-dur-fast) var(--ls-ease);
	}

	.cta-btn:hover {
		transform: translateY(-2px);
		box-shadow: var(--ls-shadow-glow);
	}
</style>
