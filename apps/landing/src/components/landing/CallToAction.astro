---
/* AIDA Action phase */
---

<section class="cta reveal" aria-labelledby="cta-heading">
	<div class="container cta-inner">
		<div class="geo-line cta-line" aria-hidden="true"></div>
		<h2 id="cta-heading" class="cta-heading">
			Center your daily life, today.
		</h2>
		<p class="cta-sub">
			Free with one <span lang="en">Modfolio Connect</span> account.
		</p>
		<a href="/auth/login" class="cta-btn">Get Started</a>
	</div>
</section>

<style>
	.cta {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-16) var(--ls-space-12);
	}

	.cta-inner {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.cta-line {
		margin-bottom: var(--ls-space-6);
	}

	.cta-heading {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-2xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		letter-spacing: var(--ls-tracking-tight);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.cta-sub {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-md);
		color: var(--ls-text-secondary);
		margin-bottom: var(--ls-space-8);
	}

	.cta-btn {
		display: inline-flex;
		align-items: center;
		padding: var(--ls-space-4) var(--ls-space-8);
		background: var(--ls-interactive);
		color: #fff;
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-lg);
		font-weight: 600;
		border-radius: var(--ls-r-lg);
		transition:
			background var(--ls-dur-fast) var(--ls-ease),
			transform var(--ls-dur-fast) var(--ls-ease);
	}

	.cta-btn:hover {
		background: var(--ls-interactive-hover);
		transform: translateY(-1px);
	}
</style>
