<section class="cta reveal" aria-labelledby="cta-heading">
	<div class="cta-wash" aria-hidden="true"></div>
	<div class="container cta-inner">
		<h2 id="cta-heading" class="cta-heading">
			오늘, 한 장면 더.
		</h2>
		<a href="/auth/login" class="btn-gradient" lang="en">Unfold</a>
	</div>
</section>

<style>
	.cta {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-20);
		min-height: 60vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.cta-wash {
		position: absolute;
		inset: 0;
		background: var(--ls-gradient-soft);
		pointer-events: none;
	}

	.cta-inner {
		position: relative;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.cta-heading {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-3xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-8);
	}

</style>
