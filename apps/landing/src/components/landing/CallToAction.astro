---
---

<section class="cta reveal" aria-labelledby="cta-heading">
	<div class="cta-wash" aria-hidden="true"></div>
	<div class="container cta-inner">
		<h2 id="cta-heading" class="cta-heading">
			오늘, 한 장면 더.
		</h2>
		<a href="/auth/login" class="cta-btn" lang="en">Start Living</a>
	</div>
</section>

<style>
	.cta {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-16);
		min-height: 60vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.cta-wash {
		position: absolute;
		inset: 0;
		background: var(--ls-gradient-soft);
		pointer-events: none;
	}

	.cta-inner {
		position: relative;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.cta-heading {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-2xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-8);
	}

	.cta-btn {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 600;
		color: #fff;
		padding: var(--ls-space-3) var(--ls-space-8);
		background: var(--ls-gradient);
		background-size: 200% 200%;
		border-radius: var(--ls-r-full);
		transition:
			transform 0.4s var(--ls-ease),
			box-shadow 0.4s var(--ls-ease),
			background-position 0.6s var(--ls-ease-out);
	}

	.cta-btn:hover {
		transform: translateY(-3px) scale(1.03);
		box-shadow: 0 16px 56px var(--ls-glow-plum);
		background-position: 100% 50%;
	}
</style>
