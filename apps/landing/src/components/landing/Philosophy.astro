---
const pillars = [
	{
		label: "우리가 믿는 것",
		body: "평범한 하루는 없습니다.\n다만 아직 들여다보지 않았을 뿐입니다.",
	},
	{
		label: "우리가 만드는 것",
		body: "여행, 성장, 그리고\n아직 이름 붙이지 못한 경험들까지.\n일상의 깊이를 넓히는 방법을 만들어갑니다.",
	},
];
---

<section class="philosophy" aria-label="철학">
	<div class="container">
		<div class="philosophy-block reveal">
			{pillars.map((p, i) => (
				<div class={`philosophy-row ${i < pillars.length - 1 ? "philosophy-row--border" : ""}`}>
					<p class="philosophy-label gradient-text">{p.label}</p>
					<p class="philosophy-body">{p.body.split("\n").map((line, j) => (
						<>{j > 0 && <br />}{line}</>
					))}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.philosophy {
		position: relative;
		z-index: 1;
		padding-block: var(--ls-space-16);
	}

	.philosophy-block {
		position: relative;
		max-width: 860px;
		margin-inline: auto;
		padding-left: calc(var(--ls-space-6) + 3px);
	}

	.philosophy-block::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--ls-gradient);
		border-radius: var(--ls-r-full);
	}

	.philosophy-row {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: var(--ls-space-8);
		align-items: start;
		padding-block: var(--ls-space-8);
	}

	.philosophy-row--border {
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.philosophy-label {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-lg);
		font-weight: 700;
		line-height: var(--ls-leading-snug);
	}

	.philosophy-body {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-md);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-relaxed);
	}

	@media (max-width: 768px) {
		.philosophy-row {
			grid-template-columns: 1fr;
			gap: var(--ls-space-3);
		}
	}
</style>
