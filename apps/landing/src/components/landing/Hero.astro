---
/* Hero: 마우스 반응형 자개 배경 + 한국어 카피 */
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="hero-content container">
		<h1 id="hero-heading" class="hero-heading reveal">
			<span class="hero-line">삶의 조각들이</span>
			<span class="hero-line gradient-text">흩어져 있다면</span>
		</h1>

		<p class="hero-sub reveal" style="--reveal-delay: 0.15s">
			여행 계획은 여기, 습관 기록은 저기.<br />
			당신의 일상에 하나의 중심이 필요합니다.
		</p>

		<div class="hero-actions reveal" style="--reveal-delay: 0.3s">
			<a href="/auth/login" class="hero-btn">시작하기</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		text-align: center;
		padding-block: calc(80px + var(--ls-space-12)) var(--ls-space-12);
		background:
			radial-gradient(
				600px circle at var(--mx, 30%) var(--my, 40%),
				var(--ls-glow-plum),
				transparent 60%
			),
			radial-gradient(
				500px circle at calc(100% - var(--mx, 30%)) calc(100% - var(--my, 40%)),
				var(--ls-glow-sky),
				transparent 60%
			),
			var(--ls-void);
		transition: background 0.15s ease;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 640px;
	}

	.hero-heading {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-4xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		letter-spacing: var(--ls-tracking-tight);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-6);
	}

	.hero-line {
		display: block;
	}

	.hero-sub {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-relaxed);
		margin-bottom: var(--ls-space-8);
		max-width: 36ch;
	}

	.hero-btn {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 600;
		color: #fff;
		padding: var(--ls-space-3) var(--ls-space-8);
		background: var(--ls-gradient);
		background-size: 200% 200%;
		border-radius: var(--ls-r-full);
		transition:
			transform var(--ls-dur-fast) var(--ls-ease),
			box-shadow var(--ls-dur-fast) var(--ls-ease);
	}

	.hero-btn:hover {
		transform: translateY(-3px) scale(1.04);
		box-shadow: 0 16px 56px var(--ls-glow-plum);
		background-position: 100% 50%;
	}
</style>
