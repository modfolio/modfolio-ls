---
/* PAS Framework: Problem → Agitate → Solution */
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="hero-content container">
		<span class="section-label" lang="en">LIFESTYLE GROUP</span>

		<!-- Problem: headline -->
		<h1 id="hero-heading" class="hero-heading">
			<span class="hero-line">삶의 조각들이</span>
			<span class="hero-line gradient-text">흩어져 있다면</span>
		</h1>

		<!-- Agitate: sub -->
		<p class="hero-agitate">
			여행 계획은 여기, 습관 기록은 저기.<br />
			흩어진 일상을 하나로 모을 순 없을까?
		</p>

		<!-- Solution -->
		<p class="hero-solution">
			<strong lang="en">Modfolio LS</strong>가 라이프스타일의 중심이 됩니다.
		</p>

		<!-- CTA: value verbs -->
		<div class="hero-actions">
			<a href="/auth/login" class="btn-primary">나의 라이프스타일 시작하기</a>
			<a href="#showcase" class="btn-ghost">둘러보기</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 85vh;
		text-align: center;
		padding-block: var(--ls-space-16) var(--ls-space-12);
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-heading {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-4xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		letter-spacing: var(--ls-tracking-tight);
		margin-bottom: var(--ls-space-6);
	}

	.hero-line {
		display: block;
	}

	.hero-agitate {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-relaxed);
		margin-bottom: var(--ls-space-4);
		max-width: 40ch;
	}

	.hero-solution {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-md);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-8);
	}

	.hero-actions {
		display: flex;
		gap: var(--ls-space-4);
		flex-wrap: wrap;
		justify-content: center;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: var(--ls-space-2);
		padding: var(--ls-space-3) var(--ls-space-6);
		background: var(--ls-gradient);
		color: var(--ls-bg);
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 600;
		border-radius: var(--ls-r-md);
		transition: opacity var(--ls-dur-fast) var(--ls-ease);
	}

	.btn-primary:hover {
		opacity: 0.9;
	}

	.btn-ghost {
		display: inline-flex;
		align-items: center;
		gap: var(--ls-space-2);
		padding: var(--ls-space-3) var(--ls-space-6);
		border: 1px solid var(--ls-border-hover);
		color: var(--ls-text-secondary);
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 500;
		border-radius: var(--ls-r-md);
		transition:
			border-color var(--ls-dur-fast) var(--ls-ease),
			color var(--ls-dur-fast) var(--ls-ease);
	}

	.btn-ghost:hover {
		border-color: var(--ls-interactive);
		color: var(--ls-text);
	}
</style>
