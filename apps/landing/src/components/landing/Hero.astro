---
/* Hero: 마우스 반응형 자개 배경 + Life, Unfolded */
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="hero-content container">
		<p class="hero-eyebrow reveal" lang="en">Modfolio LS</p>
		<h1 id="hero-heading" class="reveal" style="--reveal-delay: 0.1s">
			<span class="hero-whisper">당신의 일상에는</span>
			<span class="hero-shout gradient-text">아직 펼쳐지지 않은<br />장면이 있습니다.</span>
		</h1>

		<div class="hero-actions reveal" style="--reveal-delay: 0.25s">
			<a href="/auth/login" class="btn-gradient" lang="en">Unfold</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		text-align: center;
		padding-block: calc(80px + var(--ls-space-12)) var(--ls-space-12);
		background:
			radial-gradient(
				600px circle at var(--mx, 30%) var(--my, 40%),
				color-mix(in oklch, var(--ls-plum) 12%, transparent),
				transparent 60%
			),
			radial-gradient(
				500px circle at calc(100% - var(--mx, 30%)) calc(100% - var(--my, 40%)),
				color-mix(in oklch, var(--ls-sky) 12%, transparent),
				transparent 60%
			),
			var(--ls-void);
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 860px;
	}

	.hero-eyebrow {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		color: var(--ls-text-muted);
		letter-spacing: var(--ls-tracking-widest);
		text-transform: uppercase;
		margin-bottom: var(--ls-space-8);
	}

	.hero-whisper {
		display: block;
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		font-weight: 400;
		color: var(--ls-text-muted);
		letter-spacing: var(--ls-tracking-normal);
		margin-bottom: var(--ls-space-5);
	}

	.hero-shout {
		display: block;
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-4xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		letter-spacing: var(--ls-tracking-tight);
		margin-bottom: var(--ls-space-10);
	}

</style>
