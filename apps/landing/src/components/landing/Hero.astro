---
/* PAS Framework: Problem - Agitate - Solution */
---

<section class="hero" aria-labelledby="hero-heading">
	<!-- Geometric decorations -->
	<div class="hero-geo" aria-hidden="true">
		<div class="geo-ring hero-ring"></div>
		<div class="geo-dot hero-dot-1"></div>
		<div class="geo-dot hero-dot-2"></div>
	</div>

	<div class="hero-content container">
		<span class="section-label" lang="en">LIFESTYLE GROUP</span>

		<h1 id="hero-heading" class="hero-heading">
			<span class="hero-line">Scattered moments</span>
			<span class="hero-line accent-text">deserve a center.</span>
		</h1>

		<p class="hero-agitate">
			Travel plans here, habit logs there.<br />
			What if your daily life had one home?
		</p>

		<p class="hero-solution">
			<strong lang="en">Modfolio LS</strong> connects your lifestyle.
		</p>

		<div class="hero-actions">
			<a href="/auth/login" class="btn-primary">Get Started</a>
			<a href="#showcase" class="btn-ghost">Explore</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 85vh;
		text-align: center;
		padding-block: var(--ls-space-16) var(--ls-space-12);
		overflow: hidden;
	}

	.hero-geo {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.hero-ring {
		top: 15%;
		right: 8%;
		width: 280px;
		height: 280px;
		animation: ls-spin 60s linear infinite;
	}

	.hero-dot-1 {
		top: 25%;
		left: 12%;
		animation: ls-float var(--ls-dur-breath) var(--ls-ease-float) infinite;
	}

	.hero-dot-2 {
		bottom: 20%;
		right: 15%;
		width: 4px;
		height: 4px;
		opacity: 0.5;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-heading {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-4xl);
		font-weight: 700;
		line-height: var(--ls-leading-tight);
		letter-spacing: var(--ls-tracking-tight);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-6);
	}

	.hero-line {
		display: block;
	}

	.hero-agitate {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-lg);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-relaxed);
		margin-bottom: var(--ls-space-4);
		max-width: 40ch;
	}

	.hero-solution {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-md);
		color: var(--ls-text);
		margin-bottom: var(--ls-space-8);
	}

	.hero-actions {
		display: flex;
		gap: var(--ls-space-4);
		flex-wrap: wrap;
		justify-content: center;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		padding: var(--ls-space-3) var(--ls-space-6);
		background: var(--ls-interactive);
		color: #fff;
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 600;
		border-radius: var(--ls-r-md);
		transition:
			background var(--ls-dur-fast) var(--ls-ease),
			transform var(--ls-dur-fast) var(--ls-ease);
	}

	.btn-primary:hover {
		background: var(--ls-interactive-hover);
		transform: translateY(-1px);
	}

	.btn-ghost {
		display: inline-flex;
		align-items: center;
		padding: var(--ls-space-3) var(--ls-space-6);
		border: 1px solid var(--ls-border);
		color: var(--ls-text-secondary);
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-base);
		font-weight: 500;
		border-radius: var(--ls-r-md);
		transition:
			border-color var(--ls-dur-fast) var(--ls-ease),
			color var(--ls-dur-fast) var(--ls-ease);
	}

	.btn-ghost:hover {
		border-color: var(--ls-interactive);
		color: var(--ls-text);
	}

	@keyframes ls-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (max-width: 640px) {
		.hero-ring {
			width: 160px;
			height: 160px;
			top: 10%;
			right: -5%;
		}
	}
</style>
