---
/* Content Feed — placeholder for future API integration */
const tabs = [
	{ id: "all", label: "전체" },
	{ id: "travel", label: "여행" },
	{ id: "wellness", label: "웰니스" },
];
---

<section class="feed" aria-labelledby="feed-heading">
	<h2 id="feed-heading" class="section-heading">라이프스타일 피드</h2>
	<p class="feed-subtitle">
		<span lang="en">KeepNBuild</span>, <span lang="en">Worthee</span>에 관련된 소식과 콘텐츠
	</p>

	<div class="feed-tabs" role="tablist" aria-label="콘텐츠 필터">
		{tabs.map((tab, i) => (
			<button
				role="tab"
				aria-selected={i === 0 ? "true" : "false"}
				data-feed={tab.id}
				class={`feed-tab ${i === 0 ? "feed-tab-active" : ""}`}
			>
				{tab.label}
			</button>
		))}
	</div>

	<div class="feed-grid" role="tabpanel">
		{Array.from({ length: 3 }).map(() => (
			<div class="feed-card feed-skeleton" aria-hidden="true">
				<div class="skeleton-line skeleton-title" />
				<div class="skeleton-line skeleton-body" />
				<div class="skeleton-line skeleton-body short" />
			</div>
		))}
	</div>

	<p class="feed-coming">
		곧 여행 뉴스, 웰니스 아티클, <span lang="en">Modfolio Press</span> 뉴스레터가 여기에 표시됩니다.
	</p>
</section>

<style>
	.feed {
		padding-top: var(--ls-space-6);
		border-top: 1px solid var(--ls-border-subtle);
	}

	.feed-subtitle {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		margin-bottom: var(--ls-space-5);
	}

	.feed-tabs {
		display: flex;
		gap: var(--ls-space-2);
		margin-bottom: var(--ls-space-5);
	}

	.feed-tab {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 500;
		letter-spacing: var(--ls-tracking-wide);
		padding: var(--ls-space-2) var(--ls-space-4);
		border-radius: var(--ls-r-full);
		color: var(--ls-text-muted);
		border: 1px solid var(--ls-border);
		transition:
			color var(--ls-dur-fast) var(--ls-ease),
			border-color var(--ls-dur-fast) var(--ls-ease),
			background var(--ls-dur-fast) var(--ls-ease);
	}

	.feed-tab:hover {
		color: var(--ls-text-secondary);
		border-color: var(--ls-border-hover);
	}

	.feed-tab-active {
		color: var(--ls-text);
		border-color: var(--ls-interactive);
		background: oklch(0.72 0.14 320 / 0.08);
	}

	.feed-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--ls-space-4);
		margin-bottom: var(--ls-space-6);
	}

	.feed-card {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-md);
		padding: var(--ls-space-5);
	}

	.feed-skeleton {
		opacity: 0.5;
	}

	.skeleton-line {
		height: 12px;
		border-radius: var(--ls-r-sm);
		background: var(--ls-surface-overlay);
		margin-bottom: var(--ls-space-3);
	}

	.skeleton-title {
		width: 70%;
		height: 16px;
	}

	.skeleton-body {
		width: 100%;
	}

	.skeleton-body.short {
		width: 55%;
	}

	.feed-coming {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-muted);
		text-align: center;
		padding: var(--ls-space-4);
		background: var(--ls-surface);
		border-radius: var(--ls-r-md);
		border: 1px dashed var(--ls-border);
	}
</style>
