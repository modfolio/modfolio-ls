---
interface Props {
	variant: "plum" | "sky";
	position?: "top-right" | "bottom-left";
}

const { variant, position = variant === "plum" ? "top-right" : "bottom-left" } =
	Astro.props;

const positionStyles: Record<string, string> = {
	"top-right": "top: -200px; right: -150px;",
	"bottom-left": "bottom: -200px; left: -150px;",
};
---

<div
	class="glow-orb"
	style={`background: var(--ls-glow-${variant}); ${positionStyles[position]}`}
	aria-hidden="true"
></div>

<style>
	.glow-orb {
		position: fixed;
		width: 600px;
		height: 600px;
		border-radius: 50%;
		filter: blur(120px);
		pointer-events: none;
		z-index: 0;
		animation: ls-glow-breath var(--ls-dur-breath) var(--ls-ease-float) infinite;
	}
</style>
