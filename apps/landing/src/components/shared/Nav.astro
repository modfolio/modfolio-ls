---
interface Props {
	user: import("@modfolio/connect-sdk/astro").ConnectUser | null;
}

const { user } = Astro.props;
---

<nav class="nav" aria-label="Main navigation">
	<div class="nav-inner container container-wide">
		<a href="/" class="nav-brand">
			<span class="nav-brand-text" lang="en">Modfolio</span>
			<span class="nav-brand-badge" lang="en">LS</span>
		</a>

		<div class="nav-actions">
			{user ? (
				<a href="https://life.modfolio.io" class="nav-link nav-link-primary" lang="en">Dashboard</a>
			) : (
				<a href="/auth/login" class="nav-link nav-link-primary">Start</a>
			)}
		</div>
	</div>
</nav>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(12px);
		background: oklch(0.97 0.005 80 / 0.85);
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 56px;
	}

	.nav-brand {
		display: flex;
		align-items: center;
		gap: var(--ls-space-2);
	}

	.nav-brand-text {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 600;
		letter-spacing: var(--ls-tracking-wide);
		color: var(--ls-text-secondary);
	}

	.nav-brand-badge {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 700;
		letter-spacing: var(--ls-tracking-widest);
		color: #fff;
		background: var(--ls-interactive);
		padding: 2px 10px;
		border-radius: var(--ls-r-full);
	}

	.nav-actions {
		display: flex;
		align-items: center;
	}

	.nav-link {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 500;
		color: var(--ls-text-secondary);
		padding: var(--ls-space-1) var(--ls-space-3);
		border-radius: var(--ls-r-sm);
		transition: color var(--ls-dur-fast) var(--ls-ease);
	}

	.nav-link:hover {
		color: var(--ls-text);
	}

	.nav-link-primary {
		color: #fff;
		background: var(--ls-interactive);
		font-weight: 600;
		padding: var(--ls-space-2) var(--ls-space-4);
		border-radius: var(--ls-r-md);
	}

	.nav-link-primary:hover {
		background: var(--ls-interactive-hover);
		color: #fff;
	}
</style>
