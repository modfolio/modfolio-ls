---
interface Props {
	user: import("@modfolio/connect-sdk/astro").ConnectUser | null;
}

const { user } = Astro.props;
---

<nav class="nav" aria-label="Main">
	<div class="nav-inner container container-wide">
		<a href="/" class="nav-brand">
			<span class="nav-logo" lang="en">Modfolio</span>
			<span class="nav-badge gradient-text" lang="en">LS</span>
		</a>

		{user ? (
			<a href="https://life.modfolio.io" class="nav-cta">Life</a>
		) : (
			<a href="/auth/login" class="nav-cta">시작하기</a>
		)}
	</div>
</nav>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(20px) saturate(1.4);
		background: oklch(0.98 0.005 80 / 0.7);
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 56px;
	}

	.nav-brand {
		display: flex;
		align-items: baseline;
		gap: var(--ls-space-2);
	}

	.nav-logo {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 500;
		letter-spacing: var(--ls-tracking-wide);
		color: var(--ls-text-muted);
	}

	.nav-badge {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-md);
		font-weight: 700;
	}

	.nav-cta {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 600;
		color: var(--ls-text-secondary);
		padding: var(--ls-space-2) var(--ls-space-5);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-full);
		transition:
			color var(--ls-dur-fast) var(--ls-ease),
			border-color var(--ls-dur-fast) var(--ls-ease),
			box-shadow var(--ls-dur-fast) var(--ls-ease);
	}

	.nav-cta:hover {
		color: var(--ls-text);
		border-color: var(--ls-border-hover);
		box-shadow: var(--ls-shadow-sm);
	}
</style>
