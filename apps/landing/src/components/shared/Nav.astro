---
interface Props {
	user: import("@modfolio/connect-sdk/astro").ConnectUser | null;
	current?: string;
}

const { user, current } = Astro.props;

const links = [
	{ href: "/about", label: "About" },
	{ href: "/features", label: "Features" },
	{ href: "/blog", label: "Blog" },
];
---

<nav class="nav" aria-label="Main">
	<div class="nav-inner">
		<a href="/" class="nav-brand">
			<span class="nav-logo" lang="en">Modfolio</span>
			<span class="nav-badge gradient-text" lang="en">LS</span>
			<span class="nav-brand-line" aria-hidden="true"></span>
		</a>

		<div class="nav-menu">
			{links.map((link) => (
				<a
					href={link.href}
					class={`nav-link ${current === link.href ? "nav-link-active" : ""}`}
				>
					{link.label}
				</a>
			))}
		</div>

		{user ? (
			<a href="https://life.modfolio.io" class="nav-cta">Life</a>
		) : (
			<a href="/auth/login" class="nav-cta">시작하기</a>
		)}
	</div>
</nav>

<style>
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		backdrop-filter: blur(20px) saturate(1.4);
		background: oklch(0.98 0.005 80 / 0.7);
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 80px;
		padding-inline: clamp(1rem, 4vw, 2rem);
	}

	.nav-brand {
		position: relative;
		display: flex;
		align-items: baseline;
		gap: var(--ls-space-2);
	}

	.nav-logo {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-lg);
		font-weight: 700;
		color: var(--ls-text);
	}

	.nav-badge {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-lg);
		font-weight: 700;
	}

	.nav-brand-line {
		position: absolute;
		bottom: -4px;
		left: 50%;
		width: 0;
		height: 2px;
		background: var(--ls-gradient);
		transform: translateX(-50%);
		transition: width 0.4s var(--ls-ease);
	}

	.nav-brand:hover .nav-brand-line {
		width: 100%;
	}

	.nav-menu {
		display: flex;
		gap: var(--ls-space-1);
	}

	.nav-link {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 500;
		color: var(--ls-text-muted);
		padding: var(--ls-space-2) var(--ls-space-4);
		border-radius: var(--ls-r-md);
		transition:
			color var(--ls-dur-fast) var(--ls-ease),
			background var(--ls-dur-fast) var(--ls-ease);
	}

	.nav-link:hover {
		color: var(--ls-text);
		background: var(--ls-surface-raised);
	}

	.nav-link-active {
		color: var(--ls-text);
	}

	.nav-cta {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 600;
		color: var(--ls-text-secondary);
		padding: var(--ls-space-2) var(--ls-space-5);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-full);
		transition:
			color var(--ls-dur-fast) var(--ls-ease),
			border-color var(--ls-dur-fast) var(--ls-ease),
			box-shadow var(--ls-dur-fast) var(--ls-ease);
	}

	.nav-cta:hover {
		color: var(--ls-text);
		border-color: var(--ls-interactive);
		box-shadow: 0 4px 20px var(--ls-glow-plum);
	}

	@media (max-width: 768px) {
		.nav-menu {
			display: none;
		}
	}
</style>
