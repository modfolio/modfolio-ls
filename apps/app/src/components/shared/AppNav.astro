---
interface Props {
	user: import("@modfolio/connect-sdk/astro").ConnectUser;
}

const { user } = Astro.props;
const displayName = user.name || user.email?.split("@")[0] || "User";
---

<nav class="app-nav" aria-label="App navigation">
	<div class="app-nav-inner container container-wide">
		<a href="/" class="app-nav-brand">
			<span class="app-nav-brand-text" lang="en">Modfolio LS</span>
			<span class="app-nav-badge" lang="en">Life</span>
		</a>

		<div class="app-nav-center">
			<a href="/" class="app-nav-tab app-nav-tab-active" aria-current="page">Home</a>
			<a href="#feed" class="app-nav-tab">Feed</a>
		</div>

		<div class="app-nav-user">
			<span class="app-nav-name">{displayName}</span>
			<a href="/auth/logout" class="app-nav-logout">Sign out</a>
		</div>
	</div>
</nav>

<style>
	.app-nav {
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(12px);
		background: oklch(0.97 0.005 80 / 0.85);
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.app-nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 56px;
		gap: var(--ls-space-4);
	}

	.app-nav-brand {
		display: flex;
		align-items: center;
		gap: var(--ls-space-2);
		flex-shrink: 0;
	}

	.app-nav-brand-text {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 600;
		letter-spacing: var(--ls-tracking-wide);
		color: var(--ls-text-secondary);
	}

	.app-nav-badge {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 700;
		letter-spacing: var(--ls-tracking-widest);
		color: #fff;
		background: var(--ls-interactive);
		padding: 2px 10px;
		border-radius: var(--ls-r-full);
	}

	.app-nav-center { display: flex; gap: var(--ls-space-1); }

	.app-nav-tab {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 500;
		color: var(--ls-text-muted);
		padding: var(--ls-space-2) var(--ls-space-4);
		border-radius: var(--ls-r-md);
		transition: color var(--ls-dur-fast) var(--ls-ease), background var(--ls-dur-fast) var(--ls-ease);
	}
	.app-nav-tab:hover { color: var(--ls-text-secondary); background: var(--ls-surface-raised); }
	.app-nav-tab-active { color: var(--ls-text); background: var(--ls-surface); }

	.app-nav-user { display: flex; align-items: center; gap: var(--ls-space-3); flex-shrink: 0; }

	.app-nav-name {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-secondary);
		display: none;
	}
	@media (min-width: 640px) { .app-nav-name { display: block; } }

	.app-nav-logout {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-muted);
		padding: var(--ls-space-1) var(--ls-space-3);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-sm);
		transition: color var(--ls-dur-fast), border-color var(--ls-dur-fast);
	}
	.app-nav-logout:hover { color: var(--ls-text-secondary); border-color: var(--ls-border-hover); }
</style>
