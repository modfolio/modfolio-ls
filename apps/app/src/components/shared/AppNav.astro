---
interface Props {
	user: import("@modfolio/connect-sdk/astro").ConnectUser;
}

const { user } = Astro.props;
const displayName = user.name || user.email?.split("@")[0] || "User";
---

<nav class="app-nav" aria-label="앱 내비게이션">
	<div class="app-nav-inner container container-wide">
		<a href="/" class="app-nav-brand">
			<span class="app-nav-logo" lang="en">Modfolio</span>
			<span class="app-nav-badge gradient-text" lang="en">Life</span>
		</a>

		<div class="app-nav-user">
			<span class="app-nav-name">{displayName}</span>
			<a href="/auth/logout" class="app-nav-out">로그아웃</a>
		</div>
	</div>
</nav>

<style>
	.app-nav {
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(20px) saturate(1.4);
		background: oklch(0.98 0.005 80 / 0.7);
		border-bottom: 1px solid var(--ls-border-subtle);
	}

	.app-nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 56px;
	}

	.app-nav-brand {
		display: flex;
		align-items: baseline;
		gap: var(--ls-space-2);
	}

	.app-nav-logo {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 500;
		letter-spacing: var(--ls-tracking-wide);
		color: var(--ls-text-muted);
	}

	.app-nav-badge {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-md);
		font-weight: 700;
	}

	.app-nav-user { display: flex; align-items: center; gap: var(--ls-space-3); }

	.app-nav-name {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-secondary);
		display: none;
	}
	@media (min-width: 640px) { .app-nav-name { display: block; } }

	.app-nav-out {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-muted);
		padding: var(--ls-space-1) var(--ls-space-3);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-full);
		transition: color var(--ls-dur-fast), border-color var(--ls-dur-fast);
	}
	.app-nav-out:hover { color: var(--ls-text-secondary); border-color: var(--ls-border-hover); }
</style>
