---
import { apps } from "../../lib/apps";
import AppCard from "./AppCard.astro";
---

<section class="app-grid-section" aria-labelledby="apps-heading">
	<h2 id="apps-heading" class="section-label" lang="en">YOUR APPS</h2>
	<div class="app-grid">
		{apps.map((app) => <AppCard app={app} />)}
	</div>
</section>

<style>
	.app-grid-section {
		margin-bottom: var(--ls-space-6);
	}

	.app-grid {
		display: flex;
		flex-direction: column;
		gap: var(--ls-space-4);
	}
</style>
