---
import type { LsApp } from "../../lib/apps";

interface Props {
	app: LsApp;
}

const { app } = Astro.props;
const href = app.status === "active" ? app.url : app.landingUrl;
const ctaLabel = app.status === "active" ? "열기" : "보기";
---

<a href={href} class="app-card" data-app={app.id} data-tilt target="_blank" rel="noopener">
	<h3 class="app-card-name" lang="en">{app.name}</h3>
	<p class="app-card-desc">{app.desc}</p>
	<div class="app-card-footer">
		<span class="app-card-domain" lang="en">{app.domain}</span>
		<span class={`app-card-status status-${app.status}`}>
			{app.status === "active" ? "활성" : "준비 중"}
		</span>
	</div>
	<span class="app-card-link gradient-text">{ctaLabel} &rarr;</span>
</a>

<style>
	.app-card {
		display: block;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-xl);
		padding: var(--ls-space-5);
		transition: transform 0.4s var(--ls-ease), box-shadow 0.4s var(--ls-ease), border-color 0.3s;
		will-change: transform;
	}
	.app-card:hover { border-color: var(--ls-border-hover); box-shadow: var(--ls-shadow-glow); }

	.app-card-name {
		font-family: var(--ls-font-display);
		font-size: var(--ls-text-lg);
		font-weight: 700;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-3);
	}

	.app-card-desc {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-secondary);
		line-height: var(--ls-leading-normal);
		margin-bottom: var(--ls-space-4);
	}

	.app-card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--ls-space-3);
	}

	.app-card-domain {
		font-family: var(--ls-font-code);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-muted);
	}

	.app-card-status {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		padding: 2px var(--ls-space-3);
		border-radius: var(--ls-r-full);
	}
	.status-active { background: var(--ls-status-active-bg); color: var(--ls-status-active); }
	.status-landing { background: var(--ls-status-pending-bg); color: var(--ls-status-pending); }

	.app-card-link {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 600;
	}
</style>
