---
import { apps } from "../../lib/apps";

const actions = [
	{
		label: "여행 설계하기",
		href: apps[0].status === "active" ? apps[0].url : apps[0].landingUrl,
		appId: apps[0].id,
	},
	{
		label: "습관 기록하기",
		href: apps[1].status === "active" ? apps[1].url : apps[1].landingUrl,
		appId: apps[1].id,
	},
	{
		label: "피드 보기",
		href: "#feed",
		appId: null,
	},
];
---

<section class="quick-actions" aria-label="빠른 액션">
	<div class="quick-scroll">
		{actions.map((a) => (
			<a
				href={a.href}
				class="quick-pill"
				data-app={a.appId}
				target={a.appId ? "_blank" : undefined}
				rel={a.appId ? "noopener" : undefined}
			>
				{a.label}
			</a>
		))}
	</div>
</section>

<style>
	.quick-actions { padding-bottom: var(--ls-space-6); overflow: hidden; }

	.quick-scroll {
		display: flex;
		gap: var(--ls-space-3);
		overflow-x: auto;
		scrollbar-width: none;
		padding-bottom: var(--ls-space-2);
	}
	.quick-scroll::-webkit-scrollbar { display: none; }

	.quick-pill {
		display: inline-flex;
		align-items: center;
		padding: var(--ls-space-2) var(--ls-space-5);
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-full);
		white-space: nowrap;
		flex-shrink: 0;
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-sm);
		font-weight: 500;
		color: var(--ls-text-secondary);
		transition: border-color var(--ls-dur-fast), box-shadow var(--ls-dur-fast), color var(--ls-dur-fast);
	}

	.quick-pill:hover {
		color: var(--ls-text);
		border-color: var(--ls-border-hover);
		box-shadow: var(--ls-shadow-sm);
	}
</style>
