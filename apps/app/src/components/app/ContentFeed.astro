---
const tabs = [
	{ id: "all", label: "전체" },
	{ id: "travel", label: "여행" },
	{ id: "wellness", label: "웰니스" },
];
---

<section class="feed" id="feed" aria-labelledby="feed-heading">
	<h2 id="feed-heading" class="feed-title">라이프스타일 피드</h2>

	<div class="feed-tabs" role="tablist">
		{tabs.map((tab, i) => (
			<button
				role="tab"
				aria-selected={i === 0 ? "true" : "false"}
				class={`feed-tab ${i === 0 ? "feed-tab-active" : ""}`}
			>
				{tab.label}
			</button>
		))}
	</div>

	<div class="feed-grid" role="tabpanel">
		{Array.from({ length: 3 }).map((_, i) => (
			<div class="feed-card" aria-hidden="true">
				<div class="feed-card-badge">{i % 2 === 0 ? "여행" : "웰니스"}</div>
				<div class="feed-skeleton feed-skeleton-title" />
				<div class="feed-skeleton" />
				<div class="feed-skeleton feed-skeleton-short" />
			</div>
		))}
	</div>

	<p class="feed-note">
		여행 뉴스, 웰니스 아티클, <span lang="en">Modfolio Press</span> 뉴스레터가 곧 여기에 표시됩니다.
	</p>
</section>

<style>
	.feed { flex: 1; min-width: 0; }

	.feed-title {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		font-weight: 600;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	.feed-tabs { display: flex; gap: var(--ls-space-2); margin-bottom: var(--ls-space-5); }

	.feed-tab {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 500;
		padding: var(--ls-space-2) var(--ls-space-4);
		border-radius: var(--ls-r-full);
		color: var(--ls-text-muted);
		border: 1px solid var(--ls-border);
		transition: color var(--ls-dur-fast), border-color var(--ls-dur-fast);
	}
	.feed-tab:hover { color: var(--ls-text-secondary); border-color: var(--ls-border-hover); }
	.feed-tab-active { color: var(--ls-interactive); border-color: var(--ls-interactive); }

	.feed-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: var(--ls-space-4);
		margin-bottom: var(--ls-space-6);
	}

	.feed-card {
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-md);
		padding: var(--ls-space-4);
		opacity: 0.5;
	}

	.feed-card-badge {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-muted);
		background: var(--ls-surface-raised);
		padding: 2px var(--ls-space-2);
		border-radius: var(--ls-r-sm);
		display: inline-block;
		margin-bottom: var(--ls-space-3);
	}

	.feed-skeleton {
		height: 10px;
		background: var(--ls-surface-overlay);
		border-radius: var(--ls-r-sm);
		margin-bottom: var(--ls-space-2);
	}
	.feed-skeleton-title { height: 14px; width: 70%; margin-bottom: var(--ls-space-3); }
	.feed-skeleton-short { width: 45%; }

	.feed-note {
		font-family: var(--ls-font-story);
		font-size: var(--ls-text-sm);
		color: var(--ls-text-muted);
		text-align: center;
		padding: var(--ls-space-5);
		border: 1px dashed var(--ls-border);
		border-radius: var(--ls-r-md);
	}
</style>
