---
import {
	categoryLabels,
	type FeedCategory,
	type FeedItem,
	feedItems,
	normalizeSavedIds,
	savedItems,
} from "../../lib/feed";

// Per-user saved set (read-later), read at SSR from the Astro Session (KV-backed
// via the SESSION binding). Normalizing here drops any stale/forged ids so the
// server-rendered state is always coherent, and every card renders its correct
// saved/unsaved state up front — no client flash. Auth middleware guarantees a
// signed-in user, so the session is implicitly this user's.
const saved = normalizeSavedIds(await Astro.session?.get("savedFeedIds"));
const savedSet = new Set(saved);
const isSaved = (id: string) => savedSet.has(id);
const savedFeedItems = savedItems(saved);

// Tabs: "전체" (all) + one per category + "저장한 글" (saved). Single source =
// categoryLabels for the category tabs; "saved" is a virtual view over the set.
type TabId = "all" | FeedCategory | "saved";
const tabs: { id: TabId; label: string }[] = [
	{ id: "all", label: "전체" },
	{ id: "travel", label: categoryLabels.travel },
	{ id: "wellness", label: categoryLabels.wellness },
	{ id: "saved", label: "저장한 글" },
];

// Group items per tab so each tabpanel renders its real entries.
// SSR renders every panel; the progressive-enhancement script toggles
// visibility so the feed filters without JS-only dependency ("전체" default).
const itemsFor = (id: TabId): FeedItem[] => {
	if (id === "all") return feedItems;
	if (id === "saved") return savedFeedItems;
	return feedItems.filter((item) => item.category === id);
};

const dateFmt = new Intl.DateTimeFormat("ko-KR", {
	month: "long",
	day: "numeric",
});
const formatDate = (iso: string) => {
	const d = new Date(`${iso}T00:00:00Z`);
	return Number.isNaN(d.getTime()) ? "" : dateFmt.format(d);
};
---

<section
	class="feed"
	id="feed"
	aria-labelledby="feed-heading"
	data-feed
	data-state="ready"
	data-saved-count={saved.length}
>
	<h2 id="feed-heading" class="feed-title">라이프스타일 피드</h2>

	<div class="feed-tabs" role="tablist" aria-label="피드 카테고리">
		{
			tabs.map((tab, i) => (
				<button
					type="button"
					role="tab"
					id={`feed-tab-${tab.id}`}
					aria-controls={`feed-panel-${tab.id}`}
					aria-selected={i === 0 ? "true" : "false"}
					tabindex={i === 0 ? 0 : -1}
					class={`feed-tab ${i === 0 ? "feed-tab-active" : ""}`}
					data-feed-tab={tab.id}
				>
					{tab.label}
					{tab.id === "saved" && (
						<span
							class="feed-tab-count"
							data-feed-saved-badge
							hidden={saved.length === 0}
						>
							{saved.length}
						</span>
					)}
				</button>
			))
		}
	</div>

	{
		tabs.map((tab, i) => {
			const items = itemsFor(tab.id);
			const isSavedPanel = tab.id === "saved";
			return (
				<div
					id={`feed-panel-${tab.id}`}
					role="tabpanel"
					aria-labelledby={`feed-tab-${tab.id}`}
					class="feed-panel"
					data-feed-panel={tab.id}
					tabindex="0"
					hidden={i !== 0}
				>
					<ul
						class="feed-grid"
						role="list"
						data-feed-list={tab.id}
						hidden={items.length === 0}
					>
						{items.map((item) => {
							const savedNow = isSaved(item.id);
							return (
								<li class="feed-card-wrap" data-feed-card-wrap={item.id}>
									<article class="feed-card" data-feed-card={item.id}>
										<div class="feed-card-head">
											<div class="feed-card-meta">
												<span class={`feed-card-badge badge-${item.category}`}>
													{categoryLabels[item.category]}
												</span>
												<span class="feed-card-source" lang="en">
													{item.source}
												</span>
											</div>
											<form
												class="feed-save-form"
												method="POST"
												action="/api/feed/save"
												data-feed-save-form={item.id}
											>
												<input type="hidden" name="id" value={item.id} />
												<input
													type="hidden"
													name="action"
													value={savedNow ? "unsave" : "save"}
													data-feed-save-action
												/>
												<button
													type="submit"
													class="feed-save-btn"
													data-feed-save-btn={item.id}
													aria-pressed={savedNow ? "true" : "false"}
													aria-label={savedNow ? "저장 취소" : "저장"}
													title={savedNow ? "저장 취소" : "저장"}
												>
													<svg
														class="feed-save-icon"
														viewBox="0 0 24 24"
														width="16"
														height="16"
														aria-hidden="true"
														focusable="false"
													>
														<path
															d="M6 3.5h12a1 1 0 0 1 1 1V21l-7-4.2L5 21V4.5a1 1 0 0 1 1-1Z"
															fill="none"
															stroke="currentColor"
															stroke-width="1.6"
															stroke-linejoin="round"
														/>
													</svg>
													<span class="feed-save-label">
														{savedNow ? "저장됨" : "저장"}
													</span>
												</button>
											</form>
										</div>
										{item.href ? (
											<a
												class="feed-card-titlelink"
												href={item.href}
												target="_blank"
												rel="noopener"
											>
												<h3 class="feed-card-title">{item.title}</h3>
											</a>
										) : (
											<h3 class="feed-card-title">{item.title}</h3>
										)}
										<p class="feed-card-summary">{item.summary}</p>
										<div class="feed-card-foot">
											<time class="feed-card-date" datetime={item.publishedAt}>
												{formatDate(item.publishedAt)}
											</time>
											{item.href && (
												<a
													class="feed-card-cta gradient-text"
													href={item.href}
													target="_blank"
													rel="noopener"
													aria-label={`${item.title} 읽기`}
												>
													읽기 &rarr;
												</a>
											)}
										</div>
									</article>
								</li>
							);
						})}
					</ul>
					<div
						class="feed-empty"
						role="status"
						data-feed-empty={tab.id}
						hidden={items.length !== 0}
					>
						{isSavedPanel ? (
							<>
								<p class="feed-empty-title">아직 저장한 글이 없어요</p>
								<p class="feed-empty-sub">
									마음에 드는 글의 저장 버튼을 누르면 여기 모아둘게요.
								</p>
							</>
						) : (
							<>
								<p class="feed-empty-title">이 카테고리의 글이 아직 없어요</p>
								<p class="feed-empty-sub">
									새로운 {tab.label} 이야기가 준비되면 가장 먼저 보여드릴게요.
								</p>
							</>
						)}
					</div>
				</div>
			);
		})
	}

	{/* Loading shell — hidden by default (data-state="ready"); shown only while
	    the client holds data-state="loading" around a refresh. Honest transient
	    surface the seam toggles, never a permanent freeze. */}
	<div class="feed-loading" data-feed-loading aria-hidden="true">
		{
			Array.from({ length: 3 }).map(() => (
				<div class="feed-card feed-card--skeleton">
					<div class="feed-skeleton feed-skeleton-badge" />
					<div class="feed-skeleton feed-skeleton-title" />
					<div class="feed-skeleton" />
					<div class="feed-skeleton feed-skeleton-short" />
				</div>
			))
		}
	</div>

	{/* Error fallback — revealed by the script if wiring fails. */}
	<div class="feed-error" data-feed-error role="alert" hidden>
		<p class="feed-error-title">피드를 불러오지 못했어요</p>
		<p class="feed-error-sub">잠시 후 다시 시도해 주세요.</p>
		<button type="button" class="feed-error-retry" data-feed-retry>다시 시도</button>
	</div>

	{/* Polite live region for save feedback (e.g. when a network save fails). */}
	<p class="sr-only" role="status" aria-live="polite" data-feed-announce></p>
</section>

<script is:inline>
	(function () {
		var root = document.querySelector("[data-feed]");
		if (!root) return;

		var tabs = Array.prototype.slice.call(root.querySelectorAll("[data-feed-tab]"));
		var panels = Array.prototype.slice.call(root.querySelectorAll("[data-feed-panel]"));
		var errorBox = root.querySelector("[data-feed-error]");
		var retryBtn = root.querySelector("[data-feed-retry]");
		var announce = root.querySelector("[data-feed-announce]");
		var savedBadge = root.querySelector("[data-feed-saved-badge]");

		function setAnnounce(msg) {
			if (announce) announce.textContent = msg || "";
		}

		function fail() {
			// Graceful error fallback: surface the error block, keep tabs usable.
			root.setAttribute("data-state", "ready");
			panels.forEach(function (p) {
				p.hidden = true;
			});
			if (errorBox) errorBox.hidden = false;
		}

		function showLoading() {
			// Honest transient surface: shell visible, panels hidden, until resolve.
			if (errorBox) errorBox.hidden = true;
			panels.forEach(function (p) {
				p.hidden = true;
			});
			root.setAttribute("data-state", "loading");
		}

		function activate(id, focusTab) {
			var matched = false;
			tabs.forEach(function (tab) {
				var on = tab.getAttribute("data-feed-tab") === id;
				tab.setAttribute("aria-selected", on ? "true" : "false");
				tab.setAttribute("tabindex", on ? "0" : "-1");
				tab.classList.toggle("feed-tab-active", on);
				if (on && focusTab) tab.focus();
			});
			panels.forEach(function (panel) {
				var on = panel.getAttribute("data-feed-panel") === id;
				panel.hidden = !on;
				if (on) matched = true;
			});
			return matched;
		}

		// ── Saved-set client state ──
		// Source of truth on the client is the set of card ids whose save button
		// is currently pressed. The "saved" panel is rebuilt by cloning the
		// matching cards from the "all" list, so it always mirrors the real cards.
		var allList = root.querySelector('[data-feed-list="all"]');
		var savedPanel = root.querySelector('[data-feed-panel="saved"]');
		var savedList = root.querySelector('[data-feed-list="saved"]');
		var savedEmpty = root.querySelector('[data-feed-empty="saved"]');

		function savedIdsFromDom() {
			var ids = [];
			if (!allList) return ids;
			var btns = allList.querySelectorAll("[data-feed-save-btn]");
			Array.prototype.forEach.call(btns, function (btn) {
				if (btn.getAttribute("aria-pressed") === "true") {
					ids.push(btn.getAttribute("data-feed-save-btn"));
				}
			});
			return ids;
		}

		function updateSavedCount() {
			var ids = savedIdsFromDom();
			root.setAttribute("data-saved-count", String(ids.length));
			if (savedBadge) {
				savedBadge.textContent = String(ids.length);
				savedBadge.hidden = ids.length === 0;
			}
			return ids;
		}

		// Reflect a given saved-state onto every save control for an id (a card can
		// appear in both the "all" panel and the "saved" panel).
		function applyState(id, isSavedNow) {
			var forms = root.querySelectorAll('[data-feed-save-form="' + cssEscape(id) + '"]');
			Array.prototype.forEach.call(forms, function (form) {
				var btn = form.querySelector("[data-feed-save-btn]");
				var actionInput = form.querySelector("[data-feed-save-action]");
				var label = form.querySelector(".feed-save-label");
				if (btn) {
					btn.setAttribute("aria-pressed", isSavedNow ? "true" : "false");
					btn.setAttribute("aria-label", isSavedNow ? "저장 취소" : "저장");
					btn.setAttribute("title", isSavedNow ? "저장 취소" : "저장");
				}
				if (actionInput) actionInput.value = isSavedNow ? "unsave" : "save";
				if (label) label.textContent = isSavedNow ? "저장됨" : "저장";
			});
		}

		// Minimal attribute-selector escaping for ids (our ids are slug-like, but
		// stay defensive). Prefer native CSS.escape when available.
		function cssEscape(value) {
			if (window.CSS && typeof window.CSS.escape === "function") {
				return window.CSS.escape(value);
			}
			return String(value).replace(/["\\\]]/g, "\\$&");
		}

		function rebuildSavedPanel() {
			if (!savedList || !allList || !savedPanel) return;
			var ids = updateSavedCount();

			// Clear current saved cards.
			savedList.innerHTML = "";

			if (ids.length === 0) {
				savedList.hidden = true;
				if (savedEmpty) savedEmpty.hidden = false;
				return;
			}

			// Clone source cards in the order they appear in the full feed so the
			// saved view keeps the newest-first ordering.
			var sourceWraps = allList.querySelectorAll("[data-feed-card-wrap]");
			Array.prototype.forEach.call(sourceWraps, function (wrap) {
				var id = wrap.getAttribute("data-feed-card-wrap");
				if (ids.indexOf(id) === -1) return;
				var clone = wrap.cloneNode(true);
				savedList.appendChild(clone);
				// Re-wire the cloned save form (event delegation covers it, but make
				// sure its state matches — it was cloned in the pressed state).
				applyState(id, true);
			});

			savedList.hidden = false;
			if (savedEmpty) savedEmpty.hidden = true;
		}

		// ── Save toggle: optimistic, real POST, graceful failure ──
		function onSaveSubmit(form) {
			var id = form.getAttribute("data-feed-save-form");
			if (!id) return;
			var btn = form.querySelector("[data-feed-save-btn]");
			var wasSaved = btn && btn.getAttribute("aria-pressed") === "true";
			var nextSaved = !wasSaved;

			// Optimistic flip across all instances + rebuild saved view.
			applyState(id, nextSaved);
			rebuildSavedPanel();
			if (btn) btn.setAttribute("data-pending", "true");

			fetch(form.getAttribute("action"), {
				method: "POST",
				headers: {
					"content-type": "application/json",
					accept: "application/json",
				},
				body: JSON.stringify({ id: id, action: nextSaved ? "save" : "unsave" }),
			})
				.then(function (res) {
					if (!res.ok) throw new Error("save failed: " + res.status);
					return res.json();
				})
				.then(function (data) {
					// Reconcile with the server's authoritative set.
					var serverSaved = data && Array.isArray(data.saved) ? data.saved : null;
					if (serverSaved) {
						var allBtns = root.querySelectorAll("[data-feed-save-btn]");
						Array.prototype.forEach.call(allBtns, function (b) {
							var bid = b.getAttribute("data-feed-save-btn");
							applyState(bid, serverSaved.indexOf(bid) !== -1);
						});
						rebuildSavedPanel();
					}
					if (btn) btn.removeAttribute("data-pending");
				})
				.catch(function () {
					// Revert optimistic change; tell the user.
					applyState(id, wasSaved);
					rebuildSavedPanel();
					if (btn) btn.removeAttribute("data-pending");
					setAnnounce("저장 상태를 바꾸지 못했어요. 잠시 후 다시 시도해 주세요.");
				});
		}

		try {
			if (errorBox) errorBox.hidden = true;

			tabs.forEach(function (tab) {
				tab.addEventListener("click", function () {
					activate(tab.getAttribute("data-feed-tab"), false);
				});
			});

			// Roving-tabindex keyboard support: Arrow / Home / End.
			var tablist = root.querySelector('[role="tablist"]');
			if (tablist) {
				tablist.addEventListener("keydown", function (e) {
					var idx = tabs.indexOf(document.activeElement);
					if (idx === -1) return;
					var next = -1;
					if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (idx + 1) % tabs.length;
					else if (e.key === "ArrowLeft" || e.key === "ArrowUp")
						next = (idx - 1 + tabs.length) % tabs.length;
					else if (e.key === "Home") next = 0;
					else if (e.key === "End") next = tabs.length - 1;
					if (next === -1) return;
					e.preventDefault();
					activate(tabs[next].getAttribute("data-feed-tab"), true);
				});
			}

			// Delegate save-form submits (covers cloned cards in the saved panel).
			root.addEventListener("submit", function (e) {
				var form = e.target && e.target.closest
					? e.target.closest("[data-feed-save-form]")
					: null;
				if (!form) return;
				e.preventDefault();
				onSaveSubmit(form);
			});

			if (retryBtn) {
				retryBtn.addEventListener("click", function () {
					// Real loading -> ready transition so the shell is an honest
					// surface, then resolve back to the active panel.
					showLoading();
					requestAnimationFrame(function () {
						root.setAttribute("data-state", "ready");
						if (!activate("all", true)) fail();
					});
				});
			}

			// Sync the saved panel/count from the server-rendered DOM on load.
			rebuildSavedPanel();

			// Mark ready: hides the loading shell, reveals the active panel.
			if (!activate("all", false)) {
				fail();
			} else {
				root.setAttribute("data-state", "ready");
			}
		} catch (_err) {
			fail();
		}
	})();
</script>

<style>
	.feed {
		flex: 1;
		min-width: 0;
	}

	.feed-title {
		font-family: var(--ls-font-body);
		font-size: var(--ls-text-md);
		font-weight: 600;
		color: var(--ls-text);
		margin-bottom: var(--ls-space-4);
	}

	/* ── Tabs ── */
	.feed-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--ls-space-2);
		margin-bottom: var(--ls-space-5);
	}

	.feed-tab {
		display: inline-flex;
		align-items: center;
		gap: var(--ls-space-2);
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 500;
		padding: var(--ls-space-2) var(--ls-space-4);
		border-radius: var(--ls-r-full);
		color: var(--ls-text-muted);
		border: 1px solid var(--ls-border);
		cursor: pointer;
		transition: color var(--ls-dur-fast), border-color var(--ls-dur-fast),
			background-color var(--ls-dur-fast);
	}
	.feed-tab:hover {
		color: var(--ls-text-secondary);
		border-color: var(--ls-border-hover);
	}
	.feed-tab-active {
		color: var(--ls-interactive);
		border-color: var(--ls-interactive);
		background: var(--ls-gradient-soft);
	}
	.feed-tab:focus-visible {
		outline: 2px solid var(--ls-focus-ring);
		outline-offset: 2px;
	}

	.feed-tab-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.1rem;
		height: 1.1rem;
		padding: 0 0.3rem;
		font-family: var(--ls-font-code);
		font-size: 0.65rem;
		font-weight: 600;
		line-height: 1;
		color: var(--ls-interactive);
		background: var(--ls-gradient-soft);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-full);
	}
	.feed-tab-active .feed-tab-count {
		border-color: var(--ls-interactive);
	}

	/* ── Grid + cards ── */
	.feed-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: var(--ls-space-4);
		margin-bottom: var(--ls-space-6);
		list-style: none;
		padding: 0;
	}

	.feed-card-wrap {
		display: flex;
		min-width: 0;
	}

	.feed-card {
		position: relative;
		display: flex;
		flex-direction: column;
		width: 100%;
		background: var(--ls-surface);
		border: 1px solid var(--ls-border);
		border-radius: var(--ls-r-md);
		padding: var(--ls-space-4);
		transition: transform 0.4s var(--ls-ease), box-shadow 0.4s var(--ls-ease),
			border-color var(--ls-dur-fast);
		will-change: transform;
	}
	/* Lift the card on hover when it has an outbound link inside. */
	.feed-card:has(.feed-card-titlelink:hover),
	.feed-card:has(.feed-card-cta:hover) {
		transform: translateY(-2px);
		border-color: var(--ls-border-hover);
		box-shadow: var(--ls-shadow-glow);
	}

	.feed-card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--ls-space-2);
		margin-bottom: var(--ls-space-3);
	}

	.feed-card-meta {
		display: flex;
		align-items: center;
		gap: var(--ls-space-2);
		min-width: 0;
	}

	.feed-card-badge {
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
		font-weight: 600;
		padding: 2px var(--ls-space-2);
		border-radius: var(--ls-r-sm);
	}
	.badge-travel {
		color: var(--ls-status-pending);
		background: var(--ls-status-pending-bg);
	}
	.badge-wellness {
		color: var(--ls-status-active);
		background: var(--ls-status-active-bg);
	}

	.feed-card-source {
		font-family: var(--ls-font-code);
		font-size: var(--ls-text-xs);
		color: var(--ls-text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ── Save toggle ── */
	.feed-save-form {
		margin: 0;
		flex-shrink: 0;
	}

	.feed-save-btn {
		display: inline-flex;
		align-items: center;
		gap: var(--ls-space-1);
		font-family: var(--ls-font-ui);
		font-size: var(--ls-text-xs);
